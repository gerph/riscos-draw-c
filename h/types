#define Draw_GapTo                               ((Draw_Tag)7)
#define Draw_BezierTo                            ((Draw_Tag)6)
#define Draw_LineTo                              ((Draw_Tag)(1<<3))
#define Draw_SpecialMoveTo                       ((Draw_Tag)3)
#define Draw_MoveTo                              ((Draw_Tag)(1<<1))
