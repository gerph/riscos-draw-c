/* Types */

typedef int32_t DrawV_Reason;

typedef uint8_t Draw_CapStyle;

typedef uint8_t Draw_Tag;

struct OS_Coord_s {
    int32_t x;
    int32_t y;
};
typedef struct OS_Coord_s OS_Coord;

struct Draw_PathElement_s {
    Draw_Tag tag;
    uint8_t reserved[3];
    union {
        int32_t end_path;
        Draw_PathElement * continuation;
        OS_Coord move_to;
        OS_Coord special_move_to;
        OS_Coord bezier_to[3];
        OS_Coord gap_to;
        OS_Coord line_to;
        uint8_t reserved[24];
    } data;
};
typedef struct Draw_PathElement_s Draw_PathElement;

struct Draw_Path_s {
    Draw_PathElement elements[1];
};
typedef struct Draw_Path_s Draw_Path;

typedef uint32_t Draw_FillStyle;

struct OS_Trfm_s {
    int32_t entries[3][2];
};
typedef struct OS_Trfm_s OS_Trfm;

struct Draw_ClipDescriptor_s {
    Draw_Path * path;
    Draw_FillStyle fill_style;
    OS_Trfm trfm;
};
typedef struct Draw_ClipDescriptor_s Draw_ClipDescriptor;

struct Draw_DashPattern_s {
    int32_t start;
    int32_t element_count;
    int32_t elements[1];
};
typedef struct Draw_DashPattern_s Draw_DashPattern;

typedef uint8_t Draw_JoinStyle;

struct Draw_LineStyle_s {
    Draw_JoinStyle join_style;
    Draw_CapStyle end_cap_style;
    Draw_CapStyle start_cap_style;
    uint8_t reserved;
    int32_t mitre_limit;
    int16_t start_cap_width;
    int16_t start_cap_length;
    int16_t end_cap_width;
    int16_t end_cap_length;
};
typedef struct Draw_LineStyle_s Draw_LineStyle;

typedef Draw_Path * Draw_OutputPath;




#endif
