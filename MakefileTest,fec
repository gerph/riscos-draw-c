#!/usr/bin/env riscos-amu -f
# Makefile for DrawTest - the flatten/dash/thicken/cap/fill pipeline test
# harness, sharing c/ and h/ with the Draw module itself. This is a
# secondary makefile (not the component's Makefile,fe1, which builds the
# module) - invoke it explicitly:
#
#   riscos-amu -f MakefileTest,fec
#

#
# Program specific options:
#
COMPONENT  = DrawTest

# Specifies additional targets for startup
#INITTARGET = inittarget

# Specifies additional targets for clean
#CLEANTARGET = cleantarget

# aif, for linked objects
# aof, for a partially linked AOF object
# util, for utilities built with objasm
# basic, for BASIC tools
TYPE       = aif

# The file to output (defaults ${COMPONENT})
#TARGET = <filename>

# Comma-separated list of paths to use for includes, such as:
#	C:LibName.
INCLUDES   =

# Space separated list of defines to set, eg -DDEBUG
CDEFINES   =

# Space separated list of libraries to link against, eg C:LibName.o.libLibName
# ASMLIB provides muldiv(), used throughout the pipeline stages for
# fixed-point arithmetic (this compiler has no native 64-bit integer type).
LIBS       = ${CLIB} ${ASMLIB}

# Objects to build, using the format o.<name> (will be varied for build type).
# The library objects (everything but o.test) are shared with the Draw
# module's own Makefile,fe1 - they land in o32 here and oz32 for the module
# build, so the two builds never clash even though the sources are shared.
OBJS       = o.test o.bufferdata o.geometry o.pathio o.flatten o.thicken o.cap o.dash o.fill o.transform

# Space separated list of XML files for building documentation.
#DOCSRC = <prm-in-xml-sources>


include LibraryCommand


