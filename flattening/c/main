/*******************************************************************
 * File:        main
 * Purpose:     DrawFlattening command line tool
 * Author:      YOUR NAME
 ******************************************************************/

#include <stdlib.h>
#include <stdio.h>
#include <stdint.h>
#include <string.h>
#include <math.h>

#include "swis.h"

#include "VersionNum"

#include "types.h"

int32_t in_buffer[256];
int32_t out_buffer[256];

#define FLATTENING (16)
#define THICKNESS  (4)

/* Maximum distinct vertices buffered for a single subpath while thickening. */
#define THICKEN_MAX_POINTS (64)
/* Ratio of mitre length to line width beyond which a corner is bevelled
 * instead of mitred, matching the sense of Draw_LineStyle's mitre_limit. */
#define THICKEN_MITRE_LIMIT (4.0)

/* Simple line drawing for manual debug */
#define MOVE(_x,_y) _swix(OS_Plot, _INR(0,2), 4, _x,_y)
#define DRAW(_x,_y) _swix(OS_Plot, _INR(0,2), 5, _x,_y)
#define WAIT() _swix(OS_ReadC,0)

/* Scaling for our diagram */
#define X(_x) ((_x)/64)
#define Y(_y) ((_y)/64)


void show_path(Draw_PathElement *path)
{
    int32_t subpath_start_x = 0;
    int32_t subpath_start_y = 0;

    while (path->tag != Draw_EndPath)
    {
        switch (path->tag)
        {
            case Draw_MoveTo:
                printf("MoveTo &%06x, &%06x\n", path->data.move_to.x, path->data.move_to.y);
                MOVE(X(path->data.move_to.x), Y(path->data.move_to.y));
                subpath_start_x = path->data.move_to.x;
                subpath_start_y = path->data.move_to.y;
                path = (Draw_PathElement *)(((int32_t*)path) + 3);
                break;

            case Draw_CloseGap:
                printf("CloseGap\n");
                path = (Draw_PathElement *)(((int32_t*)path) + 1);
                break;

            case Draw_CloseLine:
                printf("CloseLine\n");
                DRAW(X(subpath_start_x), Y(subpath_start_y));
                path = (Draw_PathElement *)(((int32_t*)path) + 1);
                break;

            case Draw_LineTo:
                printf("LineTo &%06x, &%06x\n", path->data.line_to.x, path->data.line_to.y);
                DRAW(X(path->data.line_to.x), Y(path->data.line_to.y));
                path = (Draw_PathElement *)(((int32_t*)path) + 3);
                break;

            case Draw_BezierTo:
                printf("BezierTo &%06x, &%06x ; &%06x, &%06x ; &%06x, &%06x\n",
                       path->data.bezier_to[0].x, path->data.bezier_to[0].y,
                       path->data.bezier_to[1].x, path->data.bezier_to[1].y,
                       path->data.bezier_to[2].x, path->data.bezier_to[2].y);

                DRAW(X(path->data.bezier_to[0].x), Y(path->data.bezier_to[0].y));
                DRAW(X(path->data.bezier_to[1].x), Y(path->data.bezier_to[1].y));
                DRAW(X(path->data.bezier_to[2].x), Y(path->data.bezier_to[2].y));

                path = (Draw_PathElement *)(((int32_t*)path) + 7);
                break;

            case Draw_EndPath:
                /* Already handled in the while */
                printf("End of path\n");
                return;

            default:
                printf("Unrecognised tag %i\n", path->tag);
                exit(1);
        }
    }
}


static int32_t iabs32(int32_t x)
{
    return x < 0 ? -x : x;
}


/* Advance a path element pointer past 'e', according to how many words that
 * tag occupies on disk. Path elements are variable length (eg a Close is a
 * single word, a MoveTo is three, a BezierTo is seven), so this must be used
 * instead of sizeof(Draw_PathElement) when walking a path.
 */
static Draw_PathElement *advance_element(Draw_PathElement *e)
{
    switch (e->tag)
    {
        case Draw_MoveTo:
        case Draw_SpecialMoveTo:
        case Draw_LineTo:
        case Draw_GapTo:
            return (Draw_PathElement *)(((int32_t *)e) + 3);

        case Draw_BezierTo:
            return (Draw_PathElement *)(((int32_t *)e) + 7);

        case Draw_CloseGap:
        case Draw_CloseLine:
            return (Draw_PathElement *)(((int32_t *)e) + 1);

        case Draw_Continuation:
            return (Draw_PathElement *)(((int32_t *)e) + 2);

        case Draw_EndPath:
        default:
            return (Draw_PathElement *)(((int32_t *)e) + 2);
    }
}

/* Recursively flatten a cubic Bezier segment using De Casteljau subdivision.
 * P0 (x0,y0) is the current pen position; P1, P2 are control points; P3 is
 * the endpoint. Emits LineTo elements into out, updating *space_remaining.
 * Returns the updated out pointer.
 */
static Draw_PathElement *flatten_bezier(
    int32_t x0, int32_t y0,
    int32_t x1, int32_t y1,
    int32_t x2, int32_t y2,
    int32_t x3, int32_t y3,
    Draw_PathElement *out,
    int32_t *space_remaining,
    int32_t flatness)
{
    int32_t ux = 2*x1 - x0 - x2;
    int32_t uy = 2*y1 - y0 - y2;
    int32_t vx = 2*x2 - x1 - x3;
    int32_t vy = 2*y2 - y1 - y3;
    int32_t d  = iabs32(ux) + iabs32(uy) + iabs32(vx) + iabs32(vy);

    if (d <= 4 * flatness)
    {
        /* Flat enough: emit a LineTo to the endpoint */
        if (*space_remaining >= (int32_t)(sizeof(int32_t) * 3))
        {
            out->tag = Draw_LineTo;
            out->data.line_to.x = x3;
            out->data.line_to.y = y3;
            out = (Draw_PathElement *)(((int32_t *)out) + 3);
            *space_remaining -= (int32_t)(sizeof(int32_t) * 3);
        }
    }
    else
    {
        /* Subdivide at t=0.5 using De Casteljau's algorithm */
        int32_t x01   = (x0  + x1)  / 2;
        int32_t y01   = (y0  + y1)  / 2;
        int32_t x12   = (x1  + x2)  / 2;
        int32_t y12   = (y1  + y2)  / 2;
        int32_t x23   = (x2  + x3)  / 2;
        int32_t y23   = (y2  + y3)  / 2;
        int32_t x012  = (x01 + x12) / 2;
        int32_t y012  = (y01 + y12) / 2;
        int32_t x123  = (x12 + x23) / 2;
        int32_t y123  = (y12 + y23) / 2;
        int32_t x0123 = (x012 + x123) / 2;
        int32_t y0123 = (y012 + y123) / 2;

        out = flatten_bezier(x0,    y0,    x01,  y01,  x012,  y012,  x0123, y0123,
                             out, space_remaining, flatness);
        out = flatten_bezier(x0123, y0123, x123, y123, x23,   y23,   x3,    y3,
                             out, space_remaining, flatness);
    }

    return out;
}


/* Flatten a Draw path, converting BezierTo elements into LineTo sequences.
 * inpath:   source path (read-only)
 * outpath:  output buffer, initially holding a single EndPath whose end_path
 *           field contains the number of bytes available after it
 * flatness: maximum permitted deviation of a line from the true curve
 */
void flatten(Draw_PathElement *inpath, Draw_PathElement *outpath, int32_t flatness)
{
    Draw_PathElement *out = outpath;
    int32_t space_remaining = outpath->data.end_path;
    int32_t cur_x = 0;
    int32_t cur_y = 0;

    while (inpath->tag != Draw_EndPath)
    {
        switch (inpath->tag)
        {
            case Draw_MoveTo:
                if (space_remaining >= (int32_t)(sizeof(int32_t) * 3))
                {
                    out->tag = Draw_MoveTo;
                    out->data.move_to.x = inpath->data.move_to.x;
                    out->data.move_to.y = inpath->data.move_to.y;
                    out = (Draw_PathElement *)(((int32_t *)out) + 3);
                    space_remaining -= (int32_t)(sizeof(int32_t) * 3);
                }
                cur_x = inpath->data.move_to.x;
                cur_y = inpath->data.move_to.y;
                inpath = (Draw_PathElement *)(((int32_t *)inpath) + 3);
                break;

            case Draw_LineTo:
                if (space_remaining >= (int32_t)(sizeof(int32_t) * 3))
                {
                    out->tag = Draw_LineTo;
                    out->data.line_to.x = inpath->data.line_to.x;
                    out->data.line_to.y = inpath->data.line_to.y;
                    out = (Draw_PathElement *)(((int32_t *)out) + 3);
                    space_remaining -= (int32_t)(sizeof(int32_t) * 3);
                }
                cur_x = inpath->data.line_to.x;
                cur_y = inpath->data.line_to.y;
                inpath = (Draw_PathElement *)(((int32_t *)inpath) + 3);
                break;

            case Draw_BezierTo:
            {
                int32_t x1 = inpath->data.bezier_to[0].x;
                int32_t y1 = inpath->data.bezier_to[0].y;
                int32_t x2 = inpath->data.bezier_to[1].x;
                int32_t y2 = inpath->data.bezier_to[1].y;
                int32_t x3 = inpath->data.bezier_to[2].x;
                int32_t y3 = inpath->data.bezier_to[2].y;
                out = flatten_bezier(cur_x, cur_y, x1, y1, x2, y2, x3, y3,
                                     out, &space_remaining, flatness);
                cur_x = x3;
                cur_y = y3;
                inpath = (Draw_PathElement *)(((int32_t *)inpath) + 7);
                break;
            }

            case Draw_CloseGap:
            case Draw_CloseLine:
                if (space_remaining >= (int32_t)(sizeof(int32_t) * 1))
                {
                    out->tag = inpath->tag;
                    out = (Draw_PathElement *)(((int32_t *)out) + 1);
                    space_remaining -= (int32_t)(sizeof(int32_t) * 1);
                }
                inpath = advance_element(inpath);
                break;

            default:
                inpath = advance_element(inpath);
                break;
        }
    }

    /* Write the closing EndPath element */
    out->tag = Draw_EndPath;
    out->data.end_path = space_remaining - (int32_t)(sizeof(int32_t) * 2);
}


/* ------------------------------------------------------------------------
 * Thickening
 *
 * Converts a flattened path (MoveTo/LineTo elements only, optionally closed
 * with CloseGap/CloseLine) into a filled outline path: each subpath becomes
 * a band of width THICKNESS, centred on the original line, THICKNESS/2 on
 * either side. The result is always made up of closed subpaths, so that it
 * can be filled reliably with a winding rule:
 *   - an open subpath becomes a single closed loop (offset out, cross over
 *     with a butt cap, offset back, cap again to close);
 *   - a closed subpath becomes two closed rings (one offset to each side,
 *     wound in opposite directions) forming an annulus.
 * Corners are mitred, extending the outer edges until they meet, unless
 * that mitre would be longer than THICKEN_MITRE_LIMIT line widths, in which
 * case the corner is bevelled instead - the same rule Draw's own line
 * styles use for mitre_limit.
 * ------------------------------------------------------------------------
 */

typedef struct {
    double x, y;
} Vec2;

static Vec2 coord_to_vec(OS_Coord p)
{
    Vec2 v;
    v.x = (double)p.x;
    v.y = (double)p.y;
    return v;
}

static int32_t round_to_int32(double v)
{
    return (int32_t)(v >= 0.0 ? v + 0.5 : v - 0.5);
}

static OS_Coord vec_to_coord(Vec2 v)
{
    OS_Coord p;
    p.x = round_to_int32(v.x);
    p.y = round_to_int32(v.y);
    return p;
}

/* Unit direction vector from a to b. Zero-length segments (a degenerate,
 * duplicated point) are given an arbitrary direction rather than dividing
 * by zero; callers tolerate this since such segments contribute nothing
 * visible.
 */
static Vec2 unit_dir(OS_Coord a, OS_Coord b)
{
    double dx = (double)b.x - (double)a.x;
    double dy = (double)b.y - (double)a.y;
    double len = sqrt(dx * dx + dy * dy);
    Vec2 v;

    if (len < 1e-9)
    {
        v.x = 1.0;
        v.y = 0.0;
        return v;
    }

    v.x = dx / len;
    v.y = dy / len;
    return v;
}

/* Point offset from V by half_thick, perpendicular to unit direction dir.
 * side_sign of +1.0 offsets to the left of dir, -1.0 to the right.
 */
static Vec2 offset_point(Vec2 V, Vec2 dir, double side_sign, double half_thick)
{
    Vec2 n;
    Vec2 p;
    n.x = -dir.y;
    n.y = dir.x;
    p.x = V.x + side_sign * half_thick * n.x;
    p.y = V.y + side_sign * half_thick * n.y;
    return p;
}

/* Compute the offset outline point(s) needed at a vertex V where the path
 * turns from unit direction dir_in to dir_out, on one side of the line
 * (side_sign, as per offset_point). Writes 1 point to out[] for a straight
 * run or a mitre join within the limit, or 2 points for a bevelled join
 * (including the degenerate cusp where the path doubles back on itself).
 * Returns the number of points written.
 */
static int join_points(Vec2 V, Vec2 dir_in, Vec2 dir_out,
                        double side_sign, double half_thick, double mitre_limit,
                        Vec2 *out)
{
    Vec2 p_in  = offset_point(V, dir_in,  side_sign, half_thick);
    Vec2 p_out = offset_point(V, dir_out, side_sign, half_thick);
    double cross = dir_in.x * dir_out.y - dir_in.y * dir_out.x;
    double dot   = dir_in.x * dir_out.x + dir_in.y * dir_out.y;

    if (fabs(cross) < 1e-6)
    {
        if (dot > 0.0)
        {
            /* Directions unchanged: both offsets coincide */
            out[0] = p_out;
            return 1;
        }

        /* Path reverses on itself: no sensible mitre, bevel across the cusp */
        out[0] = p_in;
        out[1] = p_out;
        return 2;
    }

    {
        Vec2 diff;
        double t;
        Vec2 mitre;
        double mitre_length;

        diff.x = p_out.x - p_in.x;
        diff.y = p_out.y - p_in.y;
        t = (diff.x * dir_out.y - diff.y * dir_out.x) / cross;
        mitre.x = p_in.x + t * dir_in.x;
        mitre.y = p_in.y + t * dir_in.y;
        mitre_length = sqrt((mitre.x - V.x) * (mitre.x - V.x) +
                             (mitre.y - V.y) * (mitre.y - V.y));

        if (mitre_length <= mitre_limit * 2.0 * half_thick)
        {
            out[0] = mitre;
            return 1;
        }
    }

    /* Corner too sharp for a mitre within the limit: bevel it off */
    out[0] = p_in;
    out[1] = p_out;
    return 2;
}


typedef struct {
    OS_Coord pts[THICKEN_MAX_POINTS];
    int32_t  count;
    int32_t  closed;
} Subpath;

/* Append a point, skipping it if it exactly repeats the previous one (a
 * zero-length segment) - this keeps degenerate input from producing
 * zero-length directions later on.
 */
static void thicken_add_point(Subpath *sp, int32_t x, int32_t y)
{
    if (sp->count > 0 &&
        sp->pts[sp->count - 1].x == x && sp->pts[sp->count - 1].y == y)
        return;

    if (sp->count < THICKEN_MAX_POINTS)
    {
        sp->pts[sp->count].x = x;
        sp->pts[sp->count].y = y;
        sp->count++;
    }
}

/* Read one subpath starting at inpath (which must be a MoveTo or
 * SpecialMoveTo), collecting its distinct vertices into sp. Returns the
 * element following the subpath (the next MoveTo or the EndPath).
 */
static Draw_PathElement *thicken_read_subpath(Draw_PathElement *inpath, Subpath *sp)
{
    sp->count = 0;
    sp->closed = 0;

    thicken_add_point(sp, inpath->data.move_to.x, inpath->data.move_to.y);
    inpath = advance_element(inpath);

    while (inpath->tag == Draw_LineTo || inpath->tag == Draw_GapTo)
    {
        thicken_add_point(sp, inpath->data.line_to.x, inpath->data.line_to.y);
        inpath = advance_element(inpath);
    }

    if (inpath->tag == Draw_CloseGap || inpath->tag == Draw_CloseLine)
    {
        sp->closed = 1;
        inpath = advance_element(inpath);

        /* An explicit line back to the start point is redundant once closed */
        if (sp->count > 1 &&
            sp->pts[0].x == sp->pts[sp->count - 1].x &&
            sp->pts[0].y == sp->pts[sp->count - 1].y)
        {
            sp->count--;
        }
    }

    return inpath;
}

/* Compute one side's offset polyline for an open subpath: the two ends are
 * flush (square, butt-cap) offsets of their single adjoining segment, and
 * interior vertices are joined with join_points(). out[] must have room for
 * up to 2 points per vertex.
 */
static int32_t side_offset_open(Subpath *sp, double side_sign, double half_thick, Vec2 *out)
{
    int32_t n = sp->count;
    int32_t m = 0;
    int32_t i;

    for (i = 0; i < n; i++)
    {
        Vec2 V = coord_to_vec(sp->pts[i]);

        if (i == 0)
        {
            Vec2 dir = unit_dir(sp->pts[0], sp->pts[1]);
            out[m++] = offset_point(V, dir, side_sign, half_thick);
        }
        else if (i == n - 1)
        {
            Vec2 dir = unit_dir(sp->pts[n - 2], sp->pts[n - 1]);
            out[m++] = offset_point(V, dir, side_sign, half_thick);
        }
        else
        {
            Vec2 dir_in  = unit_dir(sp->pts[i - 1], sp->pts[i]);
            Vec2 dir_out = unit_dir(sp->pts[i], sp->pts[i + 1]);
            Vec2 joined[2];
            int32_t c = join_points(V, dir_in, dir_out, side_sign, half_thick,
                                     THICKEN_MITRE_LIMIT, joined);
            int32_t k;
            for (k = 0; k < c; k++)
                out[m++] = joined[k];
        }
    }

    return m;
}

/* As side_offset_open, but every vertex wraps around to its neighbours -
 * there are no flush ends, since a closed subpath has no loose ends.
 */
static int32_t side_offset_closed(Subpath *sp, double side_sign, double half_thick, Vec2 *out)
{
    int32_t n = sp->count;
    int32_t m = 0;
    int32_t i;

    for (i = 0; i < n; i++)
    {
        Vec2 V = coord_to_vec(sp->pts[i]);
        Vec2 dir_in  = unit_dir(sp->pts[(i - 1 + n) % n], sp->pts[i]);
        Vec2 dir_out = unit_dir(sp->pts[i], sp->pts[(i + 1) % n]);
        Vec2 joined[2];
        int32_t c = join_points(V, dir_in, dir_out, side_sign, half_thick,
                                 THICKEN_MITRE_LIMIT, joined);
        int32_t k;
        for (k = 0; k < c; k++)
            out[m++] = joined[k];
    }

    return m;
}

static Draw_PathElement *emit_move(Draw_PathElement *out, int32_t *space_remaining, OS_Coord p)
{
    if (*space_remaining >= (int32_t)(sizeof(int32_t) * 3))
    {
        out->tag = Draw_MoveTo;
        out->data.move_to.x = p.x;
        out->data.move_to.y = p.y;
        out = (Draw_PathElement *)(((int32_t *)out) + 3);
        *space_remaining -= (int32_t)(sizeof(int32_t) * 3);
    }
    return out;
}

static Draw_PathElement *emit_line(Draw_PathElement *out, int32_t *space_remaining, OS_Coord p)
{
    if (*space_remaining >= (int32_t)(sizeof(int32_t) * 3))
    {
        out->tag = Draw_LineTo;
        out->data.line_to.x = p.x;
        out->data.line_to.y = p.y;
        out = (Draw_PathElement *)(((int32_t *)out) + 3);
        *space_remaining -= (int32_t)(sizeof(int32_t) * 3);
    }
    return out;
}

static Draw_PathElement *emit_close(Draw_PathElement *out, int32_t *space_remaining)
{
    if (*space_remaining >= (int32_t)(sizeof(int32_t) * 1))
    {
        out->tag = Draw_CloseLine;
        out = (Draw_PathElement *)(((int32_t *)out) + 1);
        *space_remaining -= (int32_t)(sizeof(int32_t) * 1);
    }
    return out;
}

/* Emit an open subpath as a single closed loop: out along the left offset,
 * a butt-cap straight across to the right offset, back along the right
 * offset, then CloseLine butt-caps straight back to the start.
 */
static Draw_PathElement *thicken_emit_open(Subpath *sp, double half_thick,
                                            Draw_PathElement *out, int32_t *space_remaining)
{
    Vec2 left[2 * THICKEN_MAX_POINTS];
    Vec2 right[2 * THICKEN_MAX_POINTS];
    int32_t nl = side_offset_open(sp, 1.0, half_thick, left);
    int32_t nr = side_offset_open(sp, -1.0, half_thick, right);
    int32_t i;

    if (nl < 1 || nr < 1)
        return out;

    out = emit_move(out, space_remaining, vec_to_coord(left[0]));
    for (i = 1; i < nl; i++)
        out = emit_line(out, space_remaining, vec_to_coord(left[i]));
    for (i = nr - 1; i >= 0; i--)
        out = emit_line(out, space_remaining, vec_to_coord(right[i]));
    out = emit_close(out, space_remaining);

    return out;
}

/* Emit a closed subpath as two closed rings, wound in opposite directions
 * so a nonzero winding rule fills the band between them.
 */
static Draw_PathElement *thicken_emit_closed(Subpath *sp, double half_thick,
                                              Draw_PathElement *out, int32_t *space_remaining)
{
    Vec2 left[2 * THICKEN_MAX_POINTS];
    Vec2 right[2 * THICKEN_MAX_POINTS];
    int32_t nl = side_offset_closed(sp, 1.0, half_thick, left);
    int32_t nr = side_offset_closed(sp, -1.0, half_thick, right);
    int32_t i;

    if (nl >= 3)
    {
        out = emit_move(out, space_remaining, vec_to_coord(left[0]));
        for (i = 1; i < nl; i++)
            out = emit_line(out, space_remaining, vec_to_coord(left[i]));
        out = emit_close(out, space_remaining);
    }

    if (nr >= 3)
    {
        out = emit_move(out, space_remaining, vec_to_coord(right[nr - 1]));
        for (i = nr - 2; i >= 0; i--)
            out = emit_line(out, space_remaining, vec_to_coord(right[i]));
        out = emit_close(out, space_remaining);
    }

    return out;
}

/* Thicken a flattened Draw path (MoveTo/LineTo, optionally closed with
 * CloseGap/CloseLine) into a filled outline path, THICKNESS wide and
 * centred on the original lines.
 * inpath:    source path (read-only), already flattened
 * outpath:   output buffer, initially holding a single EndPath whose
 *            end_path field contains the number of bytes available after it
 * thickness: overall width of the thickened band (THICKNESS/2 either side
 *            of the original line)
 */
void thicken(Draw_PathElement *inpath, Draw_PathElement *outpath, int32_t thickness)
{
    Draw_PathElement *out = outpath;
    int32_t space_remaining = outpath->data.end_path;
    double half_thick = thickness / 2.0;

    while (inpath->tag != Draw_EndPath)
    {
        Subpath sp;

        if (inpath->tag != Draw_MoveTo && inpath->tag != Draw_SpecialMoveTo)
        {
            /* Not at the start of a subpath - skip the stray element */
            inpath = advance_element(inpath);
            continue;
        }

        inpath = thicken_read_subpath(inpath, &sp);

        if (sp.count < 2 || half_thick <= 0.0)
        {
            /* Degenerate subpath (a single point, or no thickness): there is
             * nothing sensible to draw for it. */
            continue;
        }

        if (sp.closed)
            out = thicken_emit_closed(&sp, half_thick, out, &space_remaining);
        else
            out = thicken_emit_open(&sp, half_thick, out, &space_remaining);
    }

    /* Write the closing EndPath element */
    out->tag = Draw_EndPath;
    out->data.end_path = space_remaining - (int32_t)(sizeof(int32_t) * 2);
}


void test_flattening(void)
{
    Draw_PathElement *inpath = (Draw_PathElement *)in_buffer;
    Draw_PathElement *outpath = (Draw_PathElement *)out_buffer;
#define ADD_MOVE(_path, _x,_y) do { _path->tag = Draw_MoveTo; \
                                    _path->data.move_to.x = _x; \
                                    _path->data.move_to.y = _y; \
                                    _path = (Draw_PathElement *)(((int32_t*)_path) + 3); \
                               } while(0)
#define ADD_LINE(_path, _x,_y) do { _path->tag = Draw_LineTo; \
                                    _path->data.line_to.x = _x; \
                                    _path->data.line_to.y = _y; \
                                    _path = (Draw_PathElement *)(((int32_t*)_path) + 3); \
                               } while(0)
#define ADD_BEZIER(_path, _c1x,_c1y,_c2x,_c2y, _endx, _endy) \
                        do { _path->tag = Draw_BezierTo; \
                             _path->data.bezier_to[0].x = _c1x; \
                             _path->data.bezier_to[0].y = _c1y; \
                             _path->data.bezier_to[1].x = _c2x; \
                             _path->data.bezier_to[1].y = _c2y; \
                             _path->data.bezier_to[2].x = _endx; \
                             _path->data.bezier_to[2].y = _endy; \
                             _path = (Draw_PathElement *)(((int32_t*)_path) + 7); \
                        } while(0)
#define ADD_END(_path, space) do { _path->tag = Draw_EndPath; \
                                   _path->data.end_path = space; \
                                   _path = (Draw_PathElement *)(((int32_t*)_path) + 2); \
                              } while(0)

    ADD_MOVE(inpath, 0x8000, 0x8000);
    ADD_LINE(inpath, 0xC000, 0x8000); /* Bottom right */
    ADD_LINE(inpath, 0xC000, 0xC000); /* Top right */
    ADD_BEZIER(inpath, 0xA000, 0xC000,
               0x8000, 0xA000,
               0x8000, 0x8000); /* Curve to bottom left */
    ADD_END(inpath, 0);

    inpath = (Draw_PathElement *)in_buffer;
    /* The in_buffer now contains a simple curved corner */

    ADD_END(outpath, sizeof(out_buffer) - sizeof(int32_t)*2);
    outpath = (Draw_PathElement *)out_buffer;
    /* The out_buffer now contains a single 'END' which contains the length of the data */

    flatten(inpath, outpath, FLATTENING);

    /* Reset things so that we can do thickening */
    memcpy(in_buffer, out_buffer, sizeof(out_buffer));
    outpath = (Draw_PathElement *)out_buffer;
    ADD_END(outpath, sizeof(out_buffer) - sizeof(int32_t)*2);
    outpath = (Draw_PathElement *)out_buffer;

    thicken(inpath, outpath, THICKNESS);

    show_path(outpath);
    if (getenv("WAIT") != NULL)
        WAIT();
}

int main(int argc, char *argv[])
{
    printf("DrawFlattening " Module_FullVersionAndDate "\n");
    test_flattening();

    exit(EXIT_SUCCESS);
}
