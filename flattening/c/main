/*******************************************************************
 * File:        main
 * Purpose:     DrawFlattening command line tool
 * Author:      YOUR NAME
 ******************************************************************/

#include <stdlib.h>
#include <stdio.h>
#include <stdint.h>
#include <string.h>

#include "swis.h"

#include "VersionNum"

#include "types.h"
#include "flatten.h"
#include "dash.h"
#include "thicken.h"
#include "cap.h"

int32_t in_buffer[1024];
int32_t out_buffer[1024];

#define FLATTENING (16)
#define THICKNESS  (4)

/* Simple line drawing for manual debug */
#define MOVE(_x,_y) _swix(OS_Plot, _INR(0,2), 4, _x,_y)
#define DRAW(_x,_y) _swix(OS_Plot, _INR(0,2), 5, _x,_y)
#define WAIT() _swix(OS_ReadC,0)

/* Scaling for our diagram */
#define X(_x) ((_x)/64)
#define Y(_y) ((_y)/64)


void show_path(Draw_PathElement *path)
{
    int32_t subpath_start_x = 0;
    int32_t subpath_start_y = 0;

    while (path->tag != Draw_EndPath)
    {
        switch (path->tag)
        {
            case Draw_MoveTo:
                printf("MoveTo &%06x, &%06x\n", path->data.move_to.x, path->data.move_to.y);
                MOVE(X(path->data.move_to.x), Y(path->data.move_to.y));
                subpath_start_x = path->data.move_to.x;
                subpath_start_y = path->data.move_to.y;
                path = (Draw_PathElement *)(((int32_t*)path) + 3);
                break;

            case Draw_CloseGap:
                printf("CloseGap\n");
                path = (Draw_PathElement *)(((int32_t*)path) + 1);
                break;

            case Draw_CloseLine:
                printf("CloseLine\n");
                DRAW(X(subpath_start_x), Y(subpath_start_y));
                path = (Draw_PathElement *)(((int32_t*)path) + 1);
                break;

            case Draw_LineTo:
                printf("LineTo &%06x, &%06x\n", path->data.line_to.x, path->data.line_to.y);
                DRAW(X(path->data.line_to.x), Y(path->data.line_to.y));
                path = (Draw_PathElement *)(((int32_t*)path) + 3);
                break;

            case Draw_BezierTo:
                printf("BezierTo &%06x, &%06x ; &%06x, &%06x ; &%06x, &%06x\n",
                       path->data.bezier_to[0].x, path->data.bezier_to[0].y,
                       path->data.bezier_to[1].x, path->data.bezier_to[1].y,
                       path->data.bezier_to[2].x, path->data.bezier_to[2].y);

                DRAW(X(path->data.bezier_to[0].x), Y(path->data.bezier_to[0].y));
                DRAW(X(path->data.bezier_to[1].x), Y(path->data.bezier_to[1].y));
                DRAW(X(path->data.bezier_to[2].x), Y(path->data.bezier_to[2].y));

                path = (Draw_PathElement *)(((int32_t*)path) + 7);
                break;

            case Draw_EndPath:
                /* Already handled in the while */
                printf("End of path\n");
                return;

            default:
                printf("Unrecognised tag %i\n", path->tag);
                exit(1);
        }
    }
}

/* Reports the standard RISC OS space-report from flatten()/dash()/thicken()/
 * cap() (see path_write_result()) and says whether the caller can safely go
 * on to use the output - a negative result means it overflowed and the
 * output is incomplete, so should not be trusted.
 */
static int report_space(const char *stage, int32_t result, uint32_t capacity)
{
    if (result < 0)
    {
        uint32_t required = (uint32_t)(-result);
        printf("%s: buffer too small - needs %u bytes, only had %u (%u more needed)\n",
               stage, (unsigned int)required, (unsigned int)capacity,
               (unsigned int)(required - capacity));
        return 0;
    }

    printf("%s: ok (%d bytes spare)\n", stage, (int)result);
    return 1;
}

void test_flattening(void)
{
    Draw_PathElement *inpath = (Draw_PathElement *)in_buffer;
    Draw_PathElement *outpath = (Draw_PathElement *)out_buffer;
#define ADD_MOVE(_path, _x,_y) do { _path->tag = Draw_MoveTo; \
                                    _path->data.move_to.x = _x; \
                                    _path->data.move_to.y = _y; \
                                    _path = (Draw_PathElement *)(((int32_t*)_path) + 3); \
                               } while(0)
#define ADD_LINE(_path, _x,_y) do { _path->tag = Draw_LineTo; \
                                    _path->data.line_to.x = _x; \
                                    _path->data.line_to.y = _y; \
                                    _path = (Draw_PathElement *)(((int32_t*)_path) + 3); \
                               } while(0)
#define ADD_BEZIER(_path, _c1x,_c1y,_c2x,_c2y, _endx, _endy) \
                        do { _path->tag = Draw_BezierTo; \
                             _path->data.bezier_to[0].x = _c1x; \
                             _path->data.bezier_to[0].y = _c1y; \
                             _path->data.bezier_to[1].x = _c2x; \
                             _path->data.bezier_to[1].y = _c2y; \
                             _path->data.bezier_to[2].x = _endx; \
                             _path->data.bezier_to[2].y = _endy; \
                             _path = (Draw_PathElement *)(((int32_t*)_path) + 7); \
                        } while(0)
#define ADD_END(_path, space) do { _path->tag = Draw_EndPath; \
                                   _path->data.end_path = space; \
                                   _path = (Draw_PathElement *)(((int32_t*)_path) + 2); \
                              } while(0)

    ADD_MOVE(inpath, 0x8000, 0x8000);
    ADD_LINE(inpath, 0xC000, 0x8000); /* Bottom right */
    ADD_LINE(inpath, 0xC000, 0xC000); /* Top right */
    ADD_BEZIER(inpath, 0xA000, 0xC000,
               0x8000, 0xA000,
               0x8000, 0x8000); /* Curve to bottom left */
    ADD_END(inpath, 0);

    inpath = (Draw_PathElement *)in_buffer;
    /* The in_buffer now contains a simple curved corner */

    ADD_END(outpath, sizeof(out_buffer) - sizeof(int32_t)*2);
    outpath = (Draw_PathElement *)out_buffer;
    /* The out_buffer now contains a single 'END' which contains the length of the data */

    if (!report_space("flatten", flatten(inpath, outpath, FLATTENING), sizeof(out_buffer)))
        return;

    /* Reset things so that we can do dashing */
    memcpy(in_buffer, out_buffer, sizeof(out_buffer));
    outpath = (Draw_PathElement *)out_buffer;
    ADD_END(outpath, sizeof(out_buffer) - sizeof(int32_t)*2);
    outpath = (Draw_PathElement *)out_buffer;

    {
        struct {
            int32_t start;
            int32_t element_count;
            int32_t elements[2];
        } test_dash_pattern = { 0, 2, { 1200, 600 } };

        if (!report_space("dash", dash(inpath, outpath, (Draw_DashPattern *)&test_dash_pattern),
                           sizeof(out_buffer)))
            return;
    }

    /* Reset things so that we can do thickening */
    memcpy(in_buffer, out_buffer, sizeof(out_buffer));
    outpath = (Draw_PathElement *)out_buffer;
    ADD_END(outpath, sizeof(out_buffer) - sizeof(int32_t)*2);
    outpath = (Draw_PathElement *)out_buffer;

    if (!report_space("thicken", thicken(inpath, outpath, THICKNESS), sizeof(out_buffer)))
        return;

    show_path(outpath);
    if (getenv("WAIT") != NULL)
        WAIT();
}


/* Exercises cap() with each of Draw's four cap styles on the same bent
 * open line (so join and cap geometry both show up), one style per call.
 * Uses ADD_MOVE/ADD_LINE/ADD_END, defined above in test_flattening().
 */
void test_capping(void)
{
    static const Draw_CapStyle styles[4] = { Draw_CapButt, Draw_CapRound,
                                              Draw_CapSquare, Draw_CapTriangular };
    static const char * const names[4] = { "butt", "round", "square", "triangular" };
    const int32_t cap_thickness = 3000;
    int32_t i;

    for (i = 0; i < 4; i++)
    {
        Draw_PathElement *inpath = (Draw_PathElement *)in_buffer;
        Draw_PathElement *outpath = (Draw_PathElement *)out_buffer;
        Draw_LineStyle style;
        int32_t y = 0x1000 + i * 0x2800;

        ADD_MOVE(inpath, 0x2000, y);
        ADD_LINE(inpath, 0x6000, y);
        ADD_LINE(inpath, 0x6000, y + 0x1800);
        ADD_END(inpath, 0);
        inpath = (Draw_PathElement *)in_buffer;

        ADD_END(outpath, sizeof(out_buffer) - sizeof(int32_t)*2);
        outpath = (Draw_PathElement *)out_buffer;

        style.join_style = Draw_JoinMitred;
        style.start_cap_style = styles[i];
        style.end_cap_style = styles[i];
        style.reserved = 0;
        style.mitre_limit = 0;
        /* Wider than the line itself (>0.5 linewidth), so the triangular
         * cap flares out into a proper arrowhead rather than just tapering
         * the existing edges to a point. Ignored by the other styles. */
        style.start_cap_width = 384;   /* 1.5 linewidth */
        style.start_cap_length = 320;  /* 1.25 linewidth */
        style.end_cap_width = 384;
        style.end_cap_length = 320;

        if (!report_space(names[i], cap(inpath, outpath, cap_thickness, &style), sizeof(out_buffer)))
            continue;

        printf("--- cap style: %s ---\n", names[i]);
        show_path(outpath);
    }
}

int main(int argc, char *argv[])
{
    printf("DrawFlattening " Module_FullVersionAndDate "\n");
    test_flattening();
    test_capping();

    exit(EXIT_SUCCESS);
}
