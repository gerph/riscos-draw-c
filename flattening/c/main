/*******************************************************************
 * File:        main
 * Purpose:     DrawFlattening command line tool
 * Author:      YOUR NAME
 ******************************************************************/

#include <stdlib.h>
#include <stdio.h>
#include <stdint.h>
#include <string.h>
#include <math.h>

#include "swis.h"

#include "VersionNum"

#include "types.h"
#include "bufferdata.h"

int32_t in_buffer[1024];
int32_t out_buffer[1024];

#define FLATTENING (16)
#define THICKNESS  (4)

/* Maximum distinct vertices buffered for a single subpath while thickening
 * or dashing. */
#define PATH_MAX_POINTS (64)
/* Ratio of mitre length to line width beyond which a corner is bevelled
 * instead of mitred, matching the sense of Draw_LineStyle's mitre_limit. */
#define THICKEN_MITRE_LIMIT (4.0)

/* Simple line drawing for manual debug */
#define MOVE(_x,_y) _swix(OS_Plot, _INR(0,2), 4, _x,_y)
#define DRAW(_x,_y) _swix(OS_Plot, _INR(0,2), 5, _x,_y)
#define WAIT() _swix(OS_ReadC,0)

/* Scaling for our diagram */
#define X(_x) ((_x)/64)
#define Y(_y) ((_y)/64)


void show_path(Draw_PathElement *path)
{
    int32_t subpath_start_x = 0;
    int32_t subpath_start_y = 0;

    while (path->tag != Draw_EndPath)
    {
        switch (path->tag)
        {
            case Draw_MoveTo:
                printf("MoveTo &%06x, &%06x\n", path->data.move_to.x, path->data.move_to.y);
                MOVE(X(path->data.move_to.x), Y(path->data.move_to.y));
                subpath_start_x = path->data.move_to.x;
                subpath_start_y = path->data.move_to.y;
                path = (Draw_PathElement *)(((int32_t*)path) + 3);
                break;

            case Draw_CloseGap:
                printf("CloseGap\n");
                path = (Draw_PathElement *)(((int32_t*)path) + 1);
                break;

            case Draw_CloseLine:
                printf("CloseLine\n");
                DRAW(X(subpath_start_x), Y(subpath_start_y));
                path = (Draw_PathElement *)(((int32_t*)path) + 1);
                break;

            case Draw_LineTo:
                printf("LineTo &%06x, &%06x\n", path->data.line_to.x, path->data.line_to.y);
                DRAW(X(path->data.line_to.x), Y(path->data.line_to.y));
                path = (Draw_PathElement *)(((int32_t*)path) + 3);
                break;

            case Draw_BezierTo:
                printf("BezierTo &%06x, &%06x ; &%06x, &%06x ; &%06x, &%06x\n",
                       path->data.bezier_to[0].x, path->data.bezier_to[0].y,
                       path->data.bezier_to[1].x, path->data.bezier_to[1].y,
                       path->data.bezier_to[2].x, path->data.bezier_to[2].y);

                DRAW(X(path->data.bezier_to[0].x), Y(path->data.bezier_to[0].y));
                DRAW(X(path->data.bezier_to[1].x), Y(path->data.bezier_to[1].y));
                DRAW(X(path->data.bezier_to[2].x), Y(path->data.bezier_to[2].y));

                path = (Draw_PathElement *)(((int32_t*)path) + 7);
                break;

            case Draw_EndPath:
                /* Already handled in the while */
                printf("End of path\n");
                return;

            default:
                printf("Unrecognised tag %i\n", path->tag);
                exit(1);
        }
    }
}


static int32_t iabs32(int32_t x)
{
    return x < 0 ? -x : x;
}


/* Advance a path element pointer past 'e', according to how many words that
 * tag occupies on disk. Path elements are variable length (eg a Close is a
 * single word, a MoveTo is three, a BezierTo is seven), so this must be used
 * instead of sizeof(Draw_PathElement) when walking a path.
 */
static Draw_PathElement *advance_element(Draw_PathElement *e)
{
    switch (e->tag)
    {
        case Draw_MoveTo:
        case Draw_SpecialMoveTo:
        case Draw_LineTo:
        case Draw_GapTo:
            return (Draw_PathElement *)(((int32_t *)e) + 3);

        case Draw_BezierTo:
            return (Draw_PathElement *)(((int32_t *)e) + 7);

        case Draw_CloseGap:
        case Draw_CloseLine:
            return (Draw_PathElement *)(((int32_t *)e) + 1);

        case Draw_Continuation:
            return (Draw_PathElement *)(((int32_t *)e) + 2);

        case Draw_EndPath:
        default:
            return (Draw_PathElement *)(((int32_t *)e) + 2);
    }
}


/* ------------------------------------------------------------------------
 * Output path writing
 *
 * All of flatten()/dash()/thicken()/cap() write their output path through
 * a bufferdata_t (see h.bufferdata) rather than hand-rolled pointer
 * arithmetic and a decrementing byte count. bufferdata never writes past
 * the buffer it was given, but keeps counting how much space *would* have
 * been needed, so a caller can distinguish "ran out of space" from
 * "finished successfully" and find out exactly how much more space is
 * needed - the same information a real Draw module SWI reports back to its
 * caller (eg via R2) when asked to size a buffer.
 * ------------------------------------------------------------------------
 */

/* outpath must already hold a single EndPath element whose end_path field
 * gives the number of bytes available after it - the standard Draw module
 * output-path convention - so the writer's usable capacity is those bytes
 * plus the two words the placeholder itself occupies (which get
 * overwritten by whatever is written first).
 */
static void path_writer_init(bufferdata_t *buf, Draw_PathElement *outpath)
{
    uint32_t capacity = (uint32_t)(sizeof(int32_t) * 2) + (uint32_t)outpath->data.end_path;
    bufferdata_init(buf, (uint8_t *)outpath, capacity);
}

static void path_write_tag(bufferdata_t *buf, Draw_Tag tag)
{
    bufferdata_write_word(buf, (uint32_t)tag);
}

static void path_write_moveto(bufferdata_t *buf, OS_Coord p)
{
    path_write_tag(buf, Draw_MoveTo);
    bufferdata_write_word(buf, (uint32_t)p.x);
    bufferdata_write_word(buf, (uint32_t)p.y);
    bufferdata_complete(buf);
}

static void path_write_lineto(bufferdata_t *buf, OS_Coord p)
{
    path_write_tag(buf, Draw_LineTo);
    bufferdata_write_word(buf, (uint32_t)p.x);
    bufferdata_write_word(buf, (uint32_t)p.y);
    bufferdata_complete(buf);
}

static void path_write_gapto(bufferdata_t *buf, OS_Coord p)
{
    path_write_tag(buf, Draw_GapTo);
    bufferdata_write_word(buf, (uint32_t)p.x);
    bufferdata_write_word(buf, (uint32_t)p.y);
    bufferdata_complete(buf);
}

/* which must be Draw_CloseLine or Draw_CloseGap */
static void path_write_close(bufferdata_t *buf, Draw_Tag which)
{
    path_write_tag(buf, which);
    bufferdata_complete(buf);
}

/* The terminating EndPath is metadata about the buffer, not a path element
 * in its own right, so - unlike the writers above - this does not mark a
 * bufferdata "record" complete. Always safe to call even after a failure:
 * bufferdata_write_word never writes past the buffer it was given.
 */
static void path_write_endpath(bufferdata_t *buf)
{
    path_write_tag(buf, Draw_EndPath);
    bufferdata_write_word(buf, bufferdata_failed(buf) ? 0 : bufferdata_remaining(buf));
}

/* The standard RISC OS convention this project is following (see
 * h.bufferdata's own usage example): a positive result is the spare space
 * left in the buffer; a negative result is -(the space that would have
 * been required to succeed).
 */
static int32_t path_write_result(bufferdata_t *buf)
{
    if (bufferdata_failed(buf))
        return -(int32_t)bufferdata_required(buf);
    return (int32_t)bufferdata_remaining(buf);
}

/* Recursively flatten a cubic Bezier segment using De Casteljau subdivision.
 * P0 (x0,y0) is the current pen position; P1, P2 are control points; P3 is
 * the endpoint. Writes LineTo elements to buf.
 */
static void flatten_bezier(
    int32_t x0, int32_t y0,
    int32_t x1, int32_t y1,
    int32_t x2, int32_t y2,
    int32_t x3, int32_t y3,
    bufferdata_t *buf,
    int32_t flatness)
{
    int32_t ux = 2*x1 - x0 - x2;
    int32_t uy = 2*y1 - y0 - y2;
    int32_t vx = 2*x2 - x1 - x3;
    int32_t vy = 2*y2 - y1 - y3;
    int32_t d  = iabs32(ux) + iabs32(uy) + iabs32(vx) + iabs32(vy);

    if (d <= 4 * flatness)
    {
        /* Flat enough: emit a LineTo to the endpoint */
        OS_Coord p;
        p.x = x3;
        p.y = y3;
        path_write_lineto(buf, p);
    }
    else
    {
        /* Subdivide at t=0.5 using De Casteljau's algorithm */
        int32_t x01   = (x0  + x1)  / 2;
        int32_t y01   = (y0  + y1)  / 2;
        int32_t x12   = (x1  + x2)  / 2;
        int32_t y12   = (y1  + y2)  / 2;
        int32_t x23   = (x2  + x3)  / 2;
        int32_t y23   = (y2  + y3)  / 2;
        int32_t x012  = (x01 + x12) / 2;
        int32_t y012  = (y01 + y12) / 2;
        int32_t x123  = (x12 + x23) / 2;
        int32_t y123  = (y12 + y23) / 2;
        int32_t x0123 = (x012 + x123) / 2;
        int32_t y0123 = (y012 + y123) / 2;

        flatten_bezier(x0,    y0,    x01,  y01,  x012,  y012,  x0123, y0123,
                       buf, flatness);
        flatten_bezier(x0123, y0123, x123, y123, x23,   y23,   x3,    y3,
                       buf, flatness);
    }
}


/* Flatten a Draw path, converting BezierTo elements into LineTo sequences.
 * inpath:   source path (read-only)
 * outpath:  output buffer, initially holding a single EndPath whose end_path
 *           field contains the number of bytes available after it
 * flatness: maximum permitted deviation of a line from the true curve
 * Returns the standard RISC OS space-report: spare bytes left in outpath on
 * success, or -(bytes that would have been required) if it overflowed - see
 * the "Output path writing" section above.
 */
int32_t flatten(Draw_PathElement *inpath, Draw_PathElement *outpath, int32_t flatness)
{
    bufferdata_t buf;
    int32_t cur_x = 0;
    int32_t cur_y = 0;

    path_writer_init(&buf, outpath);

    while (inpath->tag != Draw_EndPath)
    {
        switch (inpath->tag)
        {
            case Draw_MoveTo:
                path_write_moveto(&buf, inpath->data.move_to);
                cur_x = inpath->data.move_to.x;
                cur_y = inpath->data.move_to.y;
                inpath = (Draw_PathElement *)(((int32_t *)inpath) + 3);
                break;

            case Draw_LineTo:
                path_write_lineto(&buf, inpath->data.line_to);
                cur_x = inpath->data.line_to.x;
                cur_y = inpath->data.line_to.y;
                inpath = (Draw_PathElement *)(((int32_t *)inpath) + 3);
                break;

            case Draw_BezierTo:
            {
                int32_t x1 = inpath->data.bezier_to[0].x;
                int32_t y1 = inpath->data.bezier_to[0].y;
                int32_t x2 = inpath->data.bezier_to[1].x;
                int32_t y2 = inpath->data.bezier_to[1].y;
                int32_t x3 = inpath->data.bezier_to[2].x;
                int32_t y3 = inpath->data.bezier_to[2].y;
                flatten_bezier(cur_x, cur_y, x1, y1, x2, y2, x3, y3, &buf, flatness);
                cur_x = x3;
                cur_y = y3;
                inpath = (Draw_PathElement *)(((int32_t *)inpath) + 7);
                break;
            }

            case Draw_CloseGap:
            case Draw_CloseLine:
                path_write_close(&buf, inpath->tag);
                inpath = advance_element(inpath);
                break;

            default:
                inpath = advance_element(inpath);
                break;
        }
    }

    path_write_endpath(&buf);
    return path_write_result(&buf);
}


/* ------------------------------------------------------------------------
 * Thickening
 *
 * Converts a flattened path (MoveTo/LineTo elements only, optionally closed
 * with CloseGap/CloseLine) into a filled outline path: each subpath becomes
 * a band of width THICKNESS, centred on the original line, THICKNESS/2 on
 * either side. The result is always made up of closed subpaths, so that it
 * can be filled reliably with a winding rule:
 *   - an open subpath becomes a single closed loop (offset out, cross over
 *     with a butt cap, offset back, cap again to close);
 *   - a closed subpath becomes two closed rings (one offset to each side,
 *     wound in opposite directions) forming an annulus.
 * Corners are mitred, extending the outer edges until they meet, unless
 * that mitre would be longer than THICKEN_MITRE_LIMIT line widths, in which
 * case the corner is bevelled instead - the same rule Draw's own line
 * styles use for mitre_limit.
 * ------------------------------------------------------------------------
 */

typedef struct {
    double x, y;
} Vec2;

static Vec2 coord_to_vec(OS_Coord p)
{
    Vec2 v;
    v.x = (double)p.x;
    v.y = (double)p.y;
    return v;
}

static int32_t round_to_int32(double v)
{
    return (int32_t)(v >= 0.0 ? v + 0.5 : v - 0.5);
}

static OS_Coord vec_to_coord(Vec2 v)
{
    OS_Coord p;
    p.x = round_to_int32(v.x);
    p.y = round_to_int32(v.y);
    return p;
}

/* Unit direction vector from a to b. Zero-length segments (a degenerate,
 * duplicated point) are given an arbitrary direction rather than dividing
 * by zero; callers tolerate this since such segments contribute nothing
 * visible.
 */
static Vec2 unit_dir(OS_Coord a, OS_Coord b)
{
    double dx = (double)b.x - (double)a.x;
    double dy = (double)b.y - (double)a.y;
    double len = sqrt(dx * dx + dy * dy);
    Vec2 v;

    if (len < 1e-9)
    {
        v.x = 1.0;
        v.y = 0.0;
        return v;
    }

    v.x = dx / len;
    v.y = dy / len;
    return v;
}

/* Point offset from V by half_thick, perpendicular to unit direction dir.
 * side_sign of +1.0 offsets to the left of dir, -1.0 to the right.
 */
static Vec2 offset_point(Vec2 V, Vec2 dir, double side_sign, double half_thick)
{
    Vec2 n;
    Vec2 p;
    n.x = -dir.y;
    n.y = dir.x;
    p.x = V.x + side_sign * half_thick * n.x;
    p.y = V.y + side_sign * half_thick * n.y;
    return p;
}

/* Compute the offset outline point(s) needed at a vertex V where the path
 * turns from unit direction dir_in to dir_out, on one side of the line
 * (side_sign, as per offset_point). Writes 1 point to out[] for a straight
 * run or a mitre join within the limit, or 2 points for a bevelled join
 * (including the degenerate cusp where the path doubles back on itself).
 * Returns the number of points written.
 */
static int join_points(Vec2 V, Vec2 dir_in, Vec2 dir_out,
                        double side_sign, double half_thick, double mitre_limit,
                        Vec2 *out)
{
    Vec2 p_in  = offset_point(V, dir_in,  side_sign, half_thick);
    Vec2 p_out = offset_point(V, dir_out, side_sign, half_thick);
    double cross = dir_in.x * dir_out.y - dir_in.y * dir_out.x;
    double dot   = dir_in.x * dir_out.x + dir_in.y * dir_out.y;

    if (fabs(cross) < 1e-6)
    {
        if (dot > 0.0)
        {
            /* Directions unchanged: both offsets coincide */
            out[0] = p_out;
            return 1;
        }

        /* Path reverses on itself: no sensible mitre, bevel across the cusp */
        out[0] = p_in;
        out[1] = p_out;
        return 2;
    }

    {
        Vec2 diff;
        double t;
        Vec2 mitre;
        double mitre_length;

        diff.x = p_out.x - p_in.x;
        diff.y = p_out.y - p_in.y;
        t = (diff.x * dir_out.y - diff.y * dir_out.x) / cross;
        mitre.x = p_in.x + t * dir_in.x;
        mitre.y = p_in.y + t * dir_in.y;
        mitre_length = sqrt((mitre.x - V.x) * (mitre.x - V.x) +
                             (mitre.y - V.y) * (mitre.y - V.y));

        if (mitre_length <= mitre_limit * 2.0 * half_thick)
        {
            out[0] = mitre;
            return 1;
        }
    }

    /* Corner too sharp for a mitre within the limit: bevel it off */
    out[0] = p_in;
    out[1] = p_out;
    return 2;
}


typedef struct {
    OS_Coord pts[PATH_MAX_POINTS];
    int32_t  count;
    Draw_Tag close_tag;   /* 0 (open), Draw_CloseLine or Draw_CloseGap */
} Subpath;

/* Append a point, skipping it if it exactly repeats the previous one (a
 * zero-length segment) - this keeps degenerate input from producing
 * zero-length directions later on.
 */
static void subpath_add_point(Subpath *sp, int32_t x, int32_t y)
{
    if (sp->count > 0 &&
        sp->pts[sp->count - 1].x == x && sp->pts[sp->count - 1].y == y)
        return;

    if (sp->count < PATH_MAX_POINTS)
    {
        sp->pts[sp->count].x = x;
        sp->pts[sp->count].y = y;
        sp->count++;
    }
}

/* Read one subpath starting at inpath (which must be a MoveTo or
 * SpecialMoveTo and must not yet contain any GapTo elements - ie this is for
 * reading a plain, undashed path), collecting its distinct vertices into sp.
 * Returns the element following the subpath (the next MoveTo or EndPath).
 */
static Draw_PathElement *path_read_subpath(Draw_PathElement *inpath, Subpath *sp)
{
    sp->count = 0;
    sp->close_tag = 0;

    subpath_add_point(sp, inpath->data.move_to.x, inpath->data.move_to.y);
    inpath = advance_element(inpath);

    while (inpath->tag == Draw_LineTo)
    {
        subpath_add_point(sp, inpath->data.line_to.x, inpath->data.line_to.y);
        inpath = advance_element(inpath);
    }

    if (inpath->tag == Draw_CloseGap || inpath->tag == Draw_CloseLine)
    {
        sp->close_tag = inpath->tag;
        inpath = advance_element(inpath);

        /* An explicit line back to the start point is redundant once closed */
        if (sp->count > 1 &&
            sp->pts[0].x == sp->pts[sp->count - 1].x &&
            sp->pts[0].y == sp->pts[sp->count - 1].y)
        {
            sp->count--;
        }
    }

    return inpath;
}

/* Compute one side's offset polyline for an open subpath: the two ends are
 * flush (square, butt-cap) offsets of their single adjoining segment, and
 * interior vertices are joined with join_points(). out[] must have room for
 * up to 2 points per vertex.
 */
static int32_t side_offset_open(Subpath *sp, double side_sign, double half_thick, Vec2 *out)
{
    int32_t n = sp->count;
    int32_t m = 0;
    int32_t i;

    for (i = 0; i < n; i++)
    {
        Vec2 V = coord_to_vec(sp->pts[i]);

        if (i == 0)
        {
            Vec2 dir = unit_dir(sp->pts[0], sp->pts[1]);
            out[m++] = offset_point(V, dir, side_sign, half_thick);
        }
        else if (i == n - 1)
        {
            Vec2 dir = unit_dir(sp->pts[n - 2], sp->pts[n - 1]);
            out[m++] = offset_point(V, dir, side_sign, half_thick);
        }
        else
        {
            Vec2 dir_in  = unit_dir(sp->pts[i - 1], sp->pts[i]);
            Vec2 dir_out = unit_dir(sp->pts[i], sp->pts[i + 1]);
            Vec2 joined[2];
            int32_t c = join_points(V, dir_in, dir_out, side_sign, half_thick,
                                     THICKEN_MITRE_LIMIT, joined);
            int32_t k;
            for (k = 0; k < c; k++)
                out[m++] = joined[k];
        }
    }

    return m;
}

/* As side_offset_open, but every vertex wraps around to its neighbours -
 * there are no flush ends, since a closed subpath has no loose ends.
 */
static int32_t side_offset_closed(Subpath *sp, double side_sign, double half_thick, Vec2 *out)
{
    int32_t n = sp->count;
    int32_t m = 0;
    int32_t i;

    for (i = 0; i < n; i++)
    {
        Vec2 V = coord_to_vec(sp->pts[i]);
        Vec2 dir_in  = unit_dir(sp->pts[(i - 1 + n) % n], sp->pts[i]);
        Vec2 dir_out = unit_dir(sp->pts[i], sp->pts[(i + 1) % n]);
        Vec2 joined[2];
        int32_t c = join_points(V, dir_in, dir_out, side_sign, half_thick,
                                 THICKEN_MITRE_LIMIT, joined);
        int32_t k;
        for (k = 0; k < c; k++)
            out[m++] = joined[k];
    }

    return m;
}

/* Emit the geometry for one line cap. 'from' has already been written by
 * the caller; this always finishes by writing 'to' itself, so the writer's
 * position ends up exactly there regardless of style - callers don't need
 * to special-case the butt style.
 *
 * P is the path endpoint the cap surrounds; perp is the unit normal with
 * from == P + half_thick*perp (so to == P - half_thick*perp); dir is the
 * unit direction the cap projects into, away from the stroked line (ie
 * outward continuation for an end cap, backward continuation for a start
 * cap). width/length are Draw_LineStyle's triangular cap settings, in
 * 256ths of the line width (THICKNESS, ie 2*half_thick).
 */
static void cap_emit(bufferdata_t *buf,
                      Vec2 from, Vec2 to, Vec2 P, Vec2 perp, Vec2 dir,
                      double half_thick, Draw_CapStyle style,
                      int32_t width_256, int32_t length_256)
{
    double line_width = half_thick * 2.0;

    switch (style)
    {
        case Draw_CapRound:
        {
            /* Semicircle from 'from', through the outward bulge, to 'to' -
             * approximated with a handful of flat segments, matching the
             * rest of this project's flatten-early approach. */
            const int32_t STEPS = 8;
            int32_t i;
            for (i = 1; i < STEPS; i++)
            {
                double t = 3.14159265358979323846 * (double)i / (double)STEPS;
                Vec2 p;
                p.x = P.x + half_thick * (perp.x * cos(t) + dir.x * sin(t));
                p.y = P.y + half_thick * (perp.y * cos(t) + dir.y * sin(t));
                path_write_lineto(buf, vec_to_coord(p));
            }
            break;
        }

        case Draw_CapSquare:
        {
            /* Projects both shoulders out by half the line width, giving a
             * flat cap that stands proud of the endpoint rather than
             * sitting flush with it. */
            Vec2 p1, p2;
            p1.x = from.x + dir.x * half_thick;
            p1.y = from.y + dir.y * half_thick;
            p2.x = to.x   + dir.x * half_thick;
            p2.y = to.y   + dir.y * half_thick;
            path_write_lineto(buf, vec_to_coord(p1));
            path_write_lineto(buf, vec_to_coord(p2));
            break;
        }

        case Draw_CapTriangular:
        {
            /* An arrowhead-style point, with the base width and how far the
             * apex stands away from the line both independently settable,
             * as fractions of the line width. */
            Vec2 base1, apex, base2;
            double w = line_width * ((double)width_256 / 256.0);
            double l = line_width * ((double)length_256 / 256.0);
            base1.x = P.x + perp.x * w;
            base1.y = P.y + perp.y * w;
            apex.x  = P.x + dir.x * l;
            apex.y  = P.y + dir.y * l;
            base2.x = P.x - perp.x * w;
            base2.y = P.y - perp.y * w;
            path_write_lineto(buf, vec_to_coord(base1));
            path_write_lineto(buf, vec_to_coord(apex));
            path_write_lineto(buf, vec_to_coord(base2));
            break;
        }

        case Draw_CapButt:
        default:
            break;
    }

    path_write_lineto(buf, vec_to_coord(to));
}

/* Emit an open subpath as a single closed loop: out along the left offset,
 * across to the right offset, back along the right offset, then closing
 * back to the start. The end and start crossings are line caps - see
 * cap_emit() below - and are plain butt caps (a straight line across) when
 * style is NULL, which is what thicken() below always passes; cap() passes
 * a real style to get round/square/triangular caps instead.
 */
static void thicken_emit_open(Subpath *sp, double half_thick,
                               Draw_LineStyle *style, bufferdata_t *buf)
{
    Vec2 left[2 * PATH_MAX_POINTS];
    Vec2 right[2 * PATH_MAX_POINTS];
    int32_t nl = side_offset_open(sp, 1.0, half_thick, left);
    int32_t nr = side_offset_open(sp, -1.0, half_thick, right);
    int32_t i;

    if (nl < 1 || nr < 1)
        return;

    path_write_moveto(buf, vec_to_coord(left[0]));
    for (i = 1; i < nl; i++)
        path_write_lineto(buf, vec_to_coord(left[i]));

    if (style != NULL)
    {
        /* End cap: the line was travelling in this direction when it
         * reached its last point, and the cap projects further that way. */
        Vec2 P = coord_to_vec(sp->pts[sp->count - 1]);
        Vec2 dir = unit_dir(sp->pts[sp->count - 2], sp->pts[sp->count - 1]);
        Vec2 perp;
        perp.x = -dir.y;
        perp.y = dir.x;
        cap_emit(buf, left[nl - 1], right[nr - 1], P, perp, dir,
                 half_thick, style->end_cap_style,
                 style->end_cap_width, style->end_cap_length);
    }
    else
        path_write_lineto(buf, vec_to_coord(right[nr - 1]));

    for (i = nr - 2; i >= 0; i--)
        path_write_lineto(buf, vec_to_coord(right[i]));

    if (style != NULL)
    {
        /* Start cap: projects backwards, away from the direction the line
         * heads off in from its first point. */
        Vec2 P = coord_to_vec(sp->pts[0]);
        Vec2 dir = unit_dir(sp->pts[0], sp->pts[1]);
        Vec2 perp, out_dir;
        perp.x = dir.y;
        perp.y = -dir.x;
        out_dir.x = -dir.x;
        out_dir.y = -dir.y;
        cap_emit(buf, right[0], left[0], P, perp, out_dir,
                 half_thick, style->start_cap_style,
                 style->start_cap_width, style->start_cap_length);
    }

    path_write_close(buf, Draw_CloseLine);
}

/* Emit a closed subpath as two closed rings, wound in opposite directions
 * so a nonzero winding rule fills the band between them.
 */
static void thicken_emit_closed(Subpath *sp, double half_thick, bufferdata_t *buf)
{
    Vec2 left[2 * PATH_MAX_POINTS];
    Vec2 right[2 * PATH_MAX_POINTS];
    int32_t nl = side_offset_closed(sp, 1.0, half_thick, left);
    int32_t nr = side_offset_closed(sp, -1.0, half_thick, right);
    int32_t i;

    if (nl >= 3)
    {
        path_write_moveto(buf, vec_to_coord(left[0]));
        for (i = 1; i < nl; i++)
            path_write_lineto(buf, vec_to_coord(left[i]));
        path_write_close(buf, Draw_CloseLine);
    }

    if (nr >= 3)
    {
        path_write_moveto(buf, vec_to_coord(right[nr - 1]));
        for (i = nr - 2; i >= 0; i--)
            path_write_lineto(buf, vec_to_coord(right[i]));
        path_write_close(buf, Draw_CloseLine);
    }
}

/* A path being thickened may already have gaps in it (from dash()): a
 * GapTo, or a closing edge of CloseGap. Unlike Subpath, GappedPath keeps
 * every vertex - including the ones either side of a gap - along with a
 * flag for whether the edge leading into it is a gap (unstroked) or a real
 * line.
 */
typedef struct {
    OS_Coord pts[PATH_MAX_POINTS];
    uint8_t  gap_before[PATH_MAX_POINTS]; /* gap_before[i]: edge pts[i-1]->pts[i] is unstroked; [0] unused */
    int32_t  count;
} GappedPath;

static void gapped_path_add(GappedPath *gp, int32_t x, int32_t y, int32_t is_gap_edge)
{
    if (gp->count > 0 && !is_gap_edge &&
        gp->pts[gp->count - 1].x == x && gp->pts[gp->count - 1].y == y)
        return;

    if (gp->count < PATH_MAX_POINTS)
    {
        gp->pts[gp->count].x = x;
        gp->pts[gp->count].y = y;
        gp->gap_before[gp->count] = (uint8_t)(is_gap_edge != 0);
        gp->count++;
    }
}

/* Read one subpath starting at inpath (a MoveTo or SpecialMoveTo), which may
 * contain GapTo elements and be closed with CloseGap as well as CloseLine.
 * A CloseLine appends the start point back on as a real edge; a CloseGap
 * appends it as a gap edge (ie it is never stroked), matching the fact that
 * "close with a gap" draws no line for that edge. Returns the element
 * following the subpath.
 */
static Draw_PathElement *thicken_read_gapped_subpath(Draw_PathElement *inpath, GappedPath *gp)
{
    gp->count = 0;

    gapped_path_add(gp, inpath->data.move_to.x, inpath->data.move_to.y, 0);
    inpath = advance_element(inpath);

    while (inpath->tag == Draw_LineTo || inpath->tag == Draw_GapTo)
    {
        gapped_path_add(gp, inpath->data.line_to.x, inpath->data.line_to.y,
                         inpath->tag == Draw_GapTo);
        inpath = advance_element(inpath);
    }

    if (inpath->tag == Draw_CloseGap || inpath->tag == Draw_CloseLine)
    {
        if (gp->count > 0)
            gapped_path_add(gp, gp->pts[0].x, gp->pts[0].y, inpath->tag == Draw_CloseGap);
        inpath = advance_element(inpath);
    }

    return inpath;
}

/* Thicken one already-parsed subpath, which may contain gaps. A single run
 * that loops back to its own start point with no gaps anywhere is a proper
 * closed ring (mitred/bevelled all the way round); anything else is broken
 * at each gap into independent, individually-capped open runs.
 */
static void thicken_process_gapped(GappedPath *gp, double half_thick,
                                    Draw_LineStyle *style, bufferdata_t *buf)
{
    int32_t n = gp->count;
    int32_t i;

    if (n < 2)
        return;

    if (n >= 3)
    {
        int32_t any_gap = 0;
        for (i = 1; i < n; i++)
        {
            if (gp->gap_before[i])
            {
                any_gap = 1;
                break;
            }
        }

        if (!any_gap &&
            gp->pts[0].x == gp->pts[n - 1].x && gp->pts[0].y == gp->pts[n - 1].y)
        {
            Subpath ring;
            ring.count = n - 1;
            ring.close_tag = Draw_CloseLine;
            memcpy(ring.pts, gp->pts, sizeof(OS_Coord) * ring.count);
            thicken_emit_closed(&ring, half_thick, buf);
            return;
        }
    }

    {
        int32_t run_start = 0;
        for (i = 1; i <= n; i++)
        {
            if (i == n || gp->gap_before[i])
            {
                int32_t run_count = i - run_start;
                if (run_count >= 2)
                {
                    Subpath run;
                    run.count = run_count;
                    memcpy(run.pts, gp->pts + run_start, sizeof(OS_Coord) * run_count);
                    thicken_emit_open(&run, half_thick, style, buf);
                }
                run_start = i;
            }
        }
    }
}

/* Thicken a flattened Draw path (MoveTo/LineTo/GapTo, optionally closed with
 * CloseGap/CloseLine) into a filled outline path, THICKNESS wide and
 * centred on the original lines. GapTo runs and a CloseGap's closing edge
 * are not stroked, exactly as Draw's own definition of a gap requires -
 * this is what lets a dashed path (see dash()) thicken correctly.
 * inpath:    source path (read-only), already flattened (and optionally
 *            dashed)
 * outpath:   output buffer, initially holding a single EndPath whose
 *            end_path field contains the number of bytes available after it
 * thickness: overall width of the thickened band (THICKNESS/2 either side
 *            of the original line)
 * Returns the standard RISC OS space-report - see path_write_result().
 */
int32_t thicken(Draw_PathElement *inpath, Draw_PathElement *outpath, int32_t thickness)
{
    bufferdata_t buf;
    double half_thick = thickness / 2.0;

    path_writer_init(&buf, outpath);

    while (inpath->tag != Draw_EndPath)
    {
        GappedPath gp;

        if (inpath->tag != Draw_MoveTo && inpath->tag != Draw_SpecialMoveTo)
        {
            /* Not at the start of a subpath - skip the stray element */
            inpath = advance_element(inpath);
            continue;
        }

        inpath = thicken_read_gapped_subpath(inpath, &gp);

        if (half_thick > 0.0)
            thicken_process_gapped(&gp, half_thick, NULL, &buf);
    }

    path_write_endpath(&buf);
    return path_write_result(&buf);
}


/* ------------------------------------------------------------------------
 * Capping
 *
 * Line caps only make sense at the same moment the offset geometry either
 * side of them is being generated - by the time thicken() has closed an
 * open run off into its final loop of plain LineTo elements, there is no
 * way to tell a cap edge apart from an ordinary side edge just by looking
 * at the coordinates. So rather than reprocess thicken()'s already-closed
 * output, cap() reruns the same offset/join engine as thicken() (sharing
 * all of its helper functions above) and asks it to finish each open run's
 * two ends with the requested Draw_LineStyle cap geometry instead of a
 * plain butt line. Closed rings are unaffected, since a closed subpath has
 * no ends to cap.
 * ------------------------------------------------------------------------
 */

/* Thicken a flattened (and optionally dashed) Draw path exactly as
 * thicken() does, except that the ends of open runs are finished with the
 * cap style described by 'style' (matching Draw_Stroke's own cap and join
 * block) instead of a plain butt line.
 * inpath:    source path (read-only), already flattened (and optionally
 *            dashed)
 * outpath:   output buffer, initially holding a single EndPath whose
 *            end_path field contains the number of bytes available after it
 * thickness: overall width of the thickened band (THICKNESS/2 either side
 *            of the original line)
 * style:     start/end cap styles (and, for triangular caps, their width
 *            and length) to apply; NULL behaves exactly like thicken()
 * Returns the standard RISC OS space-report - see path_write_result().
 */
int32_t cap(Draw_PathElement *inpath, Draw_PathElement *outpath, int32_t thickness,
            Draw_LineStyle *style)
{
    bufferdata_t buf;
    double half_thick = thickness / 2.0;

    if (style == NULL)
        return thicken(inpath, outpath, thickness);

    path_writer_init(&buf, outpath);

    while (inpath->tag != Draw_EndPath)
    {
        GappedPath gp;

        if (inpath->tag != Draw_MoveTo && inpath->tag != Draw_SpecialMoveTo)
        {
            inpath = advance_element(inpath);
            continue;
        }

        inpath = thicken_read_gapped_subpath(inpath, &gp);

        if (half_thick > 0.0)
            thicken_process_gapped(&gp, half_thick, style, &buf);
    }

    path_write_endpath(&buf);
    return path_write_result(&buf);
}


/* ------------------------------------------------------------------------
 * Dashing
 *
 * Splits a flattened path into on/off runs following a dash pattern. "Off"
 * runs become GapTo elements rather than separate subpaths, exactly
 * matching Draw's own definition of a gap ("do not start a new subpath") -
 * this keeps a single subpath's Move/Close structure intact through
 * dashing, and is exactly what thicken() above already knows how to stroke
 * (it treats GapTo, and a CloseGap's closing edge, as unstroked breaks).
 *
 * A closed subpath's closing edge is walked as part of the same pattern if
 * it is a CloseLine (a CloseGap's closing edge is never drawn, so it is
 * excluded, just as it is when thickening). The pattern is not specially
 * re-synchronised at that seam: as with most vector renderers, the dash run
 * that reaches back round to the start point is simply capped there like
 * any other, rather than merged with the first run.
 * ------------------------------------------------------------------------
 */

typedef struct {
    const int32_t *elements;
    int32_t count;      /* 0 means "no usable pattern" - draw solid */
    int32_t index;      /* which element we are currently within */
    int32_t on;         /* is that element drawn ("on") or a gap? */
    double  remaining;  /* distance left to travel within the current element */
} DashState;

/* Skip forward over any non-positive elements (which have nothing to
 * consume) until ds->index names a usable one, then load its length.
 * Relies on the caller having already checked at least one element is
 * positive, so this cannot spin forever.
 */
static void dash_state_reset_element(DashState *ds)
{
    while (ds->elements[ds->index] <= 0)
    {
        ds->index = (ds->index + 1) % ds->count;
        ds->on = !ds->on;
    }
    ds->remaining = (double)ds->elements[ds->index];
}

static void dash_state_advance(DashState *ds)
{
    ds->index = (ds->index + 1) % ds->count;
    ds->on = !ds->on;
    dash_state_reset_element(ds);
}

/* Set up a DashState at the start of a pattern, pre-consuming 'start'
 * distance so the dash pattern's phase offset takes effect. ds->count is
 * left as 0 if the pattern has no positive-length elements at all (eg n=0,
 * or every element is zero or negative) - a meaningless pattern that is
 * handled the same as no pattern, rather than looping forever.
 */
static void dash_state_init(DashState *ds, Draw_DashPattern *pattern)
{
    double phase;
    int32_t i;
    int32_t has_positive = 0;

    ds->elements = pattern->elements;
    ds->count = pattern->element_count;
    ds->index = 0;
    ds->on = 1;
    ds->remaining = 0.0;

    if (ds->count <= 0)
    {
        ds->count = 0;
        return;
    }

    for (i = 0; i < ds->count; i++)
    {
        if (ds->elements[i] > 0)
        {
            has_positive = 1;
            break;
        }
    }
    if (!has_positive)
    {
        ds->count = 0;
        return;
    }

    dash_state_reset_element(ds);

    phase = (double)pattern->start;
    while (phase > 0.0)
    {
        if (phase < ds->remaining)
        {
            ds->remaining -= phase;
            phase = 0.0;
        }
        else
        {
            phase -= ds->remaining;
            dash_state_advance(ds);
        }
    }
}

/* Walk points[0..n-1] as a single polyline, applying and updating the dash
 * state in ds, writing LineTo for "on" runs and GapTo for "off" runs.
 * The caller has already written the subpath's initial MoveTo.
 */
static void dash_walk(OS_Coord *points, int32_t n, DashState *ds, bufferdata_t *buf)
{
    int32_t i;

    for (i = 0; i < n - 1; i++)
    {
        Vec2 a = coord_to_vec(points[i]);
        Vec2 b = coord_to_vec(points[i + 1]);
        double seg_len = sqrt((b.x - a.x) * (b.x - a.x) + (b.y - a.y) * (b.y - a.y));
        double seg_pos = 0.0;

        while (seg_pos < seg_len)
        {
            double step = ds->remaining;
            Vec2 p;

            if (step > seg_len - seg_pos)
                step = seg_len - seg_pos;
            seg_pos += step;
            ds->remaining -= step;

            p.x = a.x + (b.x - a.x) * (seg_pos / seg_len);
            p.y = a.y + (b.y - a.y) * (seg_pos / seg_len);

            if (ds->on)
                path_write_lineto(buf, vec_to_coord(p));
            else
                path_write_gapto(buf, vec_to_coord(p));

            if (ds->remaining <= 1e-6)
                dash_state_advance(ds);
        }
    }
}

/* Apply a dash pattern to a flattened path, replacing "off" sections with
 * GapTo elements (see the section comment above for why, and how thicken()
 * consumes them).
 * inpath:   source path (read-only), already flattened
 * outpath:  output buffer, initially holding a single EndPath whose
 *           end_path field contains the number of bytes available after it
 * pattern:  the dash pattern to apply, or NULL for no dashes, in which case
 *           the path is copied through unchanged (matching Draw's own R6=0
 *           convention of "no dashes")
 * Returns the standard RISC OS space-report - see path_write_result().
 */
int32_t dash(Draw_PathElement *inpath, Draw_PathElement *outpath, Draw_DashPattern *pattern)
{
    bufferdata_t buf;
    DashState ds_template;
    int32_t have_pattern = 0;

    path_writer_init(&buf, outpath);

    if (pattern != NULL)
    {
        dash_state_init(&ds_template, pattern);
        have_pattern = (ds_template.count > 0);
    }

    while (inpath->tag != Draw_EndPath)
    {
        Subpath sp;

        if (inpath->tag != Draw_MoveTo && inpath->tag != Draw_SpecialMoveTo)
        {
            inpath = advance_element(inpath);
            continue;
        }

        inpath = path_read_subpath(inpath, &sp);

        if (sp.count < 1)
            continue;

        if (!have_pattern || sp.count < 2)
        {
            /* No usable pattern, or nothing to dash: copy through unchanged */
            int32_t i;
            path_write_moveto(&buf, sp.pts[0]);
            for (i = 1; i < sp.count; i++)
                path_write_lineto(&buf, sp.pts[i]);
            if (sp.close_tag != 0)
                path_write_close(&buf, sp.close_tag);
            continue;
        }

        {
            DashState ds = ds_template;

            path_write_moveto(&buf, sp.pts[0]);
            dash_walk(sp.pts, sp.count, &ds, &buf);

            if (sp.close_tag == Draw_CloseLine)
            {
                /* Walk the closing edge too, continuing the same pattern */
                OS_Coord seg[2];
                seg[0] = sp.pts[sp.count - 1];
                seg[1] = sp.pts[0];
                dash_walk(seg, 2, &ds, &buf);
            }
            /* A CloseGap's closing edge is never drawn, so it is left out
             * here too, exactly as it is when thickening. Either way, the
             * result is no longer topologically closed - it is left as an
             * open run of Line/GapTo elements, which is what it now is. */
        }
    }

    path_write_endpath(&buf);
    return path_write_result(&buf);
}


/* Reports the standard RISC OS space-report from flatten()/dash()/thicken()/
 * cap() (see path_write_result()) and says whether the caller can safely go
 * on to use the output - a negative result means it overflowed and the
 * output is incomplete, so should not be trusted.
 */
static int report_space(const char *stage, int32_t result, uint32_t capacity)
{
    if (result < 0)
    {
        uint32_t required = (uint32_t)(-result);
        printf("%s: buffer too small - needs %u bytes, only had %u (%u more needed)\n",
               stage, (unsigned int)required, (unsigned int)capacity,
               (unsigned int)(required - capacity));
        return 0;
    }

    printf("%s: ok (%d bytes spare)\n", stage, (int)result);
    return 1;
}

void test_flattening(void)
{
    Draw_PathElement *inpath = (Draw_PathElement *)in_buffer;
    Draw_PathElement *outpath = (Draw_PathElement *)out_buffer;
#define ADD_MOVE(_path, _x,_y) do { _path->tag = Draw_MoveTo; \
                                    _path->data.move_to.x = _x; \
                                    _path->data.move_to.y = _y; \
                                    _path = (Draw_PathElement *)(((int32_t*)_path) + 3); \
                               } while(0)
#define ADD_LINE(_path, _x,_y) do { _path->tag = Draw_LineTo; \
                                    _path->data.line_to.x = _x; \
                                    _path->data.line_to.y = _y; \
                                    _path = (Draw_PathElement *)(((int32_t*)_path) + 3); \
                               } while(0)
#define ADD_BEZIER(_path, _c1x,_c1y,_c2x,_c2y, _endx, _endy) \
                        do { _path->tag = Draw_BezierTo; \
                             _path->data.bezier_to[0].x = _c1x; \
                             _path->data.bezier_to[0].y = _c1y; \
                             _path->data.bezier_to[1].x = _c2x; \
                             _path->data.bezier_to[1].y = _c2y; \
                             _path->data.bezier_to[2].x = _endx; \
                             _path->data.bezier_to[2].y = _endy; \
                             _path = (Draw_PathElement *)(((int32_t*)_path) + 7); \
                        } while(0)
#define ADD_END(_path, space) do { _path->tag = Draw_EndPath; \
                                   _path->data.end_path = space; \
                                   _path = (Draw_PathElement *)(((int32_t*)_path) + 2); \
                              } while(0)

    ADD_MOVE(inpath, 0x8000, 0x8000);
    ADD_LINE(inpath, 0xC000, 0x8000); /* Bottom right */
    ADD_LINE(inpath, 0xC000, 0xC000); /* Top right */
    ADD_BEZIER(inpath, 0xA000, 0xC000,
               0x8000, 0xA000,
               0x8000, 0x8000); /* Curve to bottom left */
    ADD_END(inpath, 0);

    inpath = (Draw_PathElement *)in_buffer;
    /* The in_buffer now contains a simple curved corner */

    ADD_END(outpath, sizeof(out_buffer) - sizeof(int32_t)*2);
    outpath = (Draw_PathElement *)out_buffer;
    /* The out_buffer now contains a single 'END' which contains the length of the data */

    if (!report_space("flatten", flatten(inpath, outpath, FLATTENING), sizeof(out_buffer)))
        return;

    /* Reset things so that we can do dashing */
    memcpy(in_buffer, out_buffer, sizeof(out_buffer));
    outpath = (Draw_PathElement *)out_buffer;
    ADD_END(outpath, sizeof(out_buffer) - sizeof(int32_t)*2);
    outpath = (Draw_PathElement *)out_buffer;

    {
        struct {
            int32_t start;
            int32_t element_count;
            int32_t elements[2];
        } test_dash_pattern = { 0, 2, { 1200, 600 } };

        if (!report_space("dash", dash(inpath, outpath, (Draw_DashPattern *)&test_dash_pattern),
                           sizeof(out_buffer)))
            return;
    }

    /* Reset things so that we can do thickening */
    memcpy(in_buffer, out_buffer, sizeof(out_buffer));
    outpath = (Draw_PathElement *)out_buffer;
    ADD_END(outpath, sizeof(out_buffer) - sizeof(int32_t)*2);
    outpath = (Draw_PathElement *)out_buffer;

    if (!report_space("thicken", thicken(inpath, outpath, THICKNESS), sizeof(out_buffer)))
        return;

    show_path(outpath);
    if (getenv("WAIT") != NULL)
        WAIT();
}


/* Exercises cap() with each of Draw's four cap styles on the same bent
 * open line (so join and cap geometry both show up), one style per call.
 * Uses ADD_MOVE/ADD_LINE/ADD_END, defined above in test_flattening().
 */
void test_capping(void)
{
    static const Draw_CapStyle styles[4] = { Draw_CapButt, Draw_CapRound,
                                              Draw_CapSquare, Draw_CapTriangular };
    static const char * const names[4] = { "butt", "round", "square", "triangular" };
    const int32_t cap_thickness = 3000;
    int32_t i;

    for (i = 0; i < 4; i++)
    {
        Draw_PathElement *inpath = (Draw_PathElement *)in_buffer;
        Draw_PathElement *outpath = (Draw_PathElement *)out_buffer;
        Draw_LineStyle style;
        int32_t y = 0x1000 + i * 0x2800;

        ADD_MOVE(inpath, 0x2000, y);
        ADD_LINE(inpath, 0x6000, y);
        ADD_LINE(inpath, 0x6000, y + 0x1800);
        ADD_END(inpath, 0);
        inpath = (Draw_PathElement *)in_buffer;

        ADD_END(outpath, sizeof(out_buffer) - sizeof(int32_t)*2);
        outpath = (Draw_PathElement *)out_buffer;

        style.join_style = Draw_JoinMitred;
        style.start_cap_style = styles[i];
        style.end_cap_style = styles[i];
        style.reserved = 0;
        style.mitre_limit = 0;
        /* Wider than the line itself (>0.5 linewidth), so the triangular
         * cap flares out into a proper arrowhead rather than just tapering
         * the existing edges to a point. Ignored by the other styles. */
        style.start_cap_width = 384;   /* 1.5 linewidth */
        style.start_cap_length = 320;  /* 1.25 linewidth */
        style.end_cap_width = 384;
        style.end_cap_length = 320;

        if (!report_space(names[i], cap(inpath, outpath, cap_thickness, &style), sizeof(out_buffer)))
            continue;

        printf("--- cap style: %s ---\n", names[i]);
        show_path(outpath);
    }
}

int main(int argc, char *argv[])
{
    printf("DrawFlattening " Module_FullVersionAndDate "\n");
    test_flattening();
    test_capping();

    exit(EXIT_SUCCESS);
}
