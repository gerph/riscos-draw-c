/*******************************************************************
 * File:        dash
 * Purpose:     Splitting a flattened Draw path into on/off runs following
 *              a dash pattern
 * Author:      Gerph
 ******************************************************************/

#include <math.h>
#include <stddef.h>

#include "dash.h"
#include "pathio.h"
#include "geometry.h"

typedef struct {
    const int32_t *elements;
    int32_t count;      /* 0 means "no usable pattern" - draw solid */
    int32_t index;      /* which element we are currently within */
    int32_t on;         /* is that element drawn ("on") or a gap? */
    double  remaining;  /* distance left to travel within the current element */
} DashState;

/* Skip forward over any non-positive elements (which have nothing to
 * consume) until ds->index names a usable one, then load its length.
 * Relies on the caller having already checked at least one element is
 * positive, so this cannot spin forever.
 */
static void dash_state_reset_element(DashState *ds)
{
    while (ds->elements[ds->index] <= 0)
    {
        ds->index = (ds->index + 1) % ds->count;
        ds->on = !ds->on;
    }
    ds->remaining = (double)ds->elements[ds->index];
}

static void dash_state_advance(DashState *ds)
{
    ds->index = (ds->index + 1) % ds->count;
    ds->on = !ds->on;
    dash_state_reset_element(ds);
}

/* Set up a DashState at the start of a pattern, pre-consuming 'start'
 * distance so the dash pattern's phase offset takes effect. ds->count is
 * left as 0 if the pattern has no positive-length elements at all (eg n=0,
 * or every element is zero or negative) - a meaningless pattern that is
 * handled the same as no pattern, rather than looping forever.
 */
static void dash_state_init(DashState *ds, Draw_DashPattern *pattern)
{
    double phase;
    int32_t i;
    int32_t has_positive = 0;

    ds->elements = pattern->elements;
    ds->count = pattern->element_count;
    ds->index = 0;
    ds->on = 1;
    ds->remaining = 0.0;

    if (ds->count <= 0)
    {
        ds->count = 0;
        return;
    }

    for (i = 0; i < ds->count; i++)
    {
        if (ds->elements[i] > 0)
        {
            has_positive = 1;
            break;
        }
    }
    if (!has_positive)
    {
        ds->count = 0;
        return;
    }

    dash_state_reset_element(ds);

    phase = (double)pattern->start;
    while (phase > 0.0)
    {
        if (phase < ds->remaining)
        {
            ds->remaining -= phase;
            phase = 0.0;
        }
        else
        {
            phase -= ds->remaining;
            dash_state_advance(ds);
        }
    }
}

/* Walk points[0..n-1] as a single polyline, applying and updating the dash
 * state in ds, writing LineTo for "on" runs and GapTo for "off" runs.
 * The caller has already written the subpath's initial MoveTo.
 */
static void dash_walk(OS_Coord *points, int32_t n, DashState *ds, bufferdata_t *buf)
{
    int32_t i;

    for (i = 0; i < n - 1; i++)
    {
        Vec2 a = coord_to_vec(points[i]);
        Vec2 b = coord_to_vec(points[i + 1]);
        double seg_len = sqrt((b.x - a.x) * (b.x - a.x) + (b.y - a.y) * (b.y - a.y));
        double seg_pos = 0.0;

        while (seg_pos < seg_len)
        {
            double step = ds->remaining;
            Vec2 p;

            if (step > seg_len - seg_pos)
                step = seg_len - seg_pos;
            seg_pos += step;
            ds->remaining -= step;

            p.x = a.x + (b.x - a.x) * (seg_pos / seg_len);
            p.y = a.y + (b.y - a.y) * (seg_pos / seg_len);

            if (ds->on)
                path_write_lineto(buf, vec_to_coord(p));
            else
                path_write_gapto(buf, vec_to_coord(p));

            if (ds->remaining <= 1e-6)
                dash_state_advance(ds);
        }
    }
}

int32_t dash(Draw_PathElement *inpath, Draw_PathElement *outpath, Draw_DashPattern *pattern)
{
    bufferdata_t buf;
    DashState ds_template;
    int32_t have_pattern = 0;

    path_writer_init(&buf, outpath);

    if (pattern != NULL)
    {
        dash_state_init(&ds_template, pattern);
        have_pattern = (ds_template.count > 0);
    }

    while (inpath->tag != Draw_EndPath)
    {
        Subpath sp;

        if (inpath->tag != Draw_MoveTo && inpath->tag != Draw_SpecialMoveTo)
        {
            inpath = advance_element(inpath);
            continue;
        }

        inpath = path_read_subpath(inpath, &sp);

        if (sp.count < 1)
            continue;

        if (!have_pattern || sp.count < 2)
        {
            /* No usable pattern, or nothing to dash: copy through unchanged */
            int32_t i;
            path_write_moveto(&buf, sp.pts[0]);
            for (i = 1; i < sp.count; i++)
                path_write_lineto(&buf, sp.pts[i]);
            if (sp.close_tag != 0)
                path_write_close(&buf, sp.close_tag);
            continue;
        }

        {
            DashState ds = ds_template;

            path_write_moveto(&buf, sp.pts[0]);
            dash_walk(sp.pts, sp.count, &ds, &buf);

            if (sp.close_tag == Draw_CloseLine)
            {
                /* Walk the closing edge too, continuing the same pattern */
                OS_Coord seg[2];
                seg[0] = sp.pts[sp.count - 1];
                seg[1] = sp.pts[0];
                dash_walk(seg, 2, &ds, &buf);
            }
            /* A CloseGap's closing edge is never drawn, so it is left out
             * here too, exactly as it is when thickening. Either way, the
             * result is no longer topologically closed - it is left as an
             * open run of Line/GapTo elements, which is what it now is. */
        }
    }

    path_write_endpath(&buf);
    return path_write_result(&buf);
}
