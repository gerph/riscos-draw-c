/***************************************************************************
 * Description:  SWI handler routine for Draw_StrokePath
 * Parameters:   number = SWI number within SWI chunk (i.e. 0 to 63)
 *               r      = pointer to register block on entry
 *               pw     = private word for module
 * On exit:      Return NULL if SWI handled sucessfully, setting return
 *               register values (r0-r9) in r.
 *               Return error_BAD_SWI for out of range SWIs.
 *               Return an error block for a custom error.
 **************************************************************************/
_kernel_oserror *SWI_StrokePath(int number, _kernel_swi_regs *regs, void *pw)
{
    /*
     * Draw_StrokePath - Processes a path and writes its output to another path
     *
     * =>  R0 -> path
     *     R1 = stroked_path
     *     R2 -> trfm
     *     R3 = flatness
     *     R4 = thickness
     *     R5 -> line_style
     *     R6 -> dash_pattern
     * <=  R0 = end_or_used
     */

    /* Input registers */
    Draw_Path *path = (Draw_Path *)regs->r[0];
    Draw_Path * stroked_path = (Draw_Path *)regs->r[1];
    OS_Trfm *trfm = (OS_Trfm *)regs->r[2];
    int32_t flatness = (int32_t)regs->r[3];
    int32_t thickness = (int32_t)regs->r[4];
    Draw_LineStyle *line_style = (Draw_LineStyle *)regs->r[5];
    Draw_DashPattern *dash_pattern = (Draw_DashPattern *)regs->r[6];

    Draw_PathElement *result = run_pipeline(path, flatness, dash_pattern, 1, thickness,
                                             line_style, trfm);

    return deliver_path(result, 1, (Draw_PathElement *)stroked_path, regs);
}




/***************************************************************************
 * Description:  SWI handler routine for Draw_FlattenPath
 * Parameters:   number = SWI number within SWI chunk (i.e. 0 to 63)
 *               r      = pointer to register block on entry
 *               pw     = private word for module
 * On exit:      Return NULL if SWI handled sucessfully, setting return
 *               register values (r0-r9) in r.
 *               Return error_BAD_SWI for out of range SWIs.
 *               Return an error block for a custom error.
 **************************************************************************/
_kernel_oserror *SWI_FlattenPath(int number, _kernel_swi_regs *regs, void *pw)
{
    /*
     * Draw_FlattenPath - Flattens a path and writes its output to another path
     *
     * =>  R0 -> path
     *     R1 = flattened_path
     *     R2 = flatness
     * <=  R0 = end_or_used
     */

    /* Input registers */
    Draw_Path *path = (Draw_Path *)regs->r[0];
    Draw_Path * flattened_path = (Draw_Path *)regs->r[1];
    int32_t flatness = (int32_t)regs->r[2];

    Draw_PathElement *scratch;
    int32_t result;

    if (flatness == 0)
        flatness = DRAW_DEFAULT_FLATNESS;

    scratch = scratch_alloc(path_byte_size((Draw_PathElement *)path));
    if (scratch == NULL)
        return err_DrawPathFull;

    result = flatten((Draw_PathElement *)path, scratch, flatness);
    if (result < 0)
    {
        free(scratch);
        return err_DrawPathFull;
    }

    return deliver_path(scratch, 1, (Draw_PathElement *)flattened_path, regs);
}




/***************************************************************************
 * Description:  SWI handler routine for Draw_TransformPath
 * Parameters:   number = SWI number within SWI chunk (i.e. 0 to 63)
 *               r      = pointer to register block on entry
 *               pw     = private word for module
 * On exit:      Return NULL if SWI handled sucessfully, setting return
 *               register values (r0-r9) in r.
 *               Return error_BAD_SWI for out of range SWIs.
 *               Return an error block for a custom error.
 **************************************************************************/
_kernel_oserror *SWI_TransformPath(int number, _kernel_swi_regs *regs, void *pw)
{
    /*
     * Draw_TransformPath - Transforms a path and writes its output to another path
     *
     * =>  R0 -> path
     *     R1 = transformed_path
     *     R2 -> trfm
     *     R3 = &0 (constant)
     * <=  R0 = end_or_used
     */

    /* Input registers */
    Draw_Path *path = (Draw_Path *)regs->r[0];
    Draw_Path * transformed_path = (Draw_Path *)regs->r[1];
    OS_Trfm *trfm = (OS_Trfm *)regs->r[2];
    /* R3 is 0 */

    static const OS_Trfm identity_trfm = { { {0x10000, 0}, {0, 0x10000}, {0, 0} } };
    Draw_PathElement *scratch;
    int32_t result;

    if (trfm == NULL)
        trfm = (OS_Trfm *)&identity_trfm;

    scratch = scratch_alloc(path_byte_size((Draw_PathElement *)path));
    if (scratch == NULL)
        return err_DrawPathFull;

    result = transform((Draw_PathElement *)path, scratch, trfm);
    if (result < 0)
    {
        free(scratch);
        return err_DrawPathFull;
    }

    return deliver_path(scratch, 1, (Draw_PathElement *)transformed_path, regs);
}




