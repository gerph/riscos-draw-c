/***************************************************************************
 * Description:  SWI handler routine for Draw_ProcessPath
 * Parameters:   number = SWI number within SWI chunk (i.e. 0 to 63)
 *               r      = pointer to register block on entry
 *               pw     = private word for module
 * On exit:      Return NULL if SWI handled sucessfully, setting return
 *               register values (r0-r9) in r.
 *               Return error_BAD_SWI for out of range SWIs.
 *               Return an error block for a custom error.
 **************************************************************************/
_kernel_oserror *SWI_ProcessPath(int number, _kernel_swi_regs *regs, void *pw)
{
    /*
     * Draw_ProcessPath - Main Draw SWI
     *
     * =>  R0 -> path
     *     R1 = fill_style
     *     R2 -> trfm
     *     R3 = flatness
     *     R4 = thickness
     *     R5 -> line_style
     *     R6 -> dash_pattern
     *     R7 = processed_path
     * <=  R0 = end_or_used
     */

    /* Input registers */
    Draw_Path *path = (Draw_Path *)regs->r[0];
    Draw_FillStyle fill_style = (Draw_FillStyle)regs->r[1];
    OS_Trfm *trfm = (OS_Trfm *)regs->r[2];
    int32_t flatness = (int32_t)regs->r[3];
    int32_t thickness = (int32_t)regs->r[4];
    Draw_LineStyle *line_style = (Draw_LineStyle *)regs->r[5];
    Draw_DashPattern *dash_pattern = (Draw_DashPattern *)regs->r[6];
    Draw_OutputPath processed_path = (Draw_OutputPath)regs->r[7];
    int32_t r7 = (int32_t)regs->r[7];

    Draw_PathElement *cur = (Draw_PathElement *)path;
    Draw_PathElement *scratch;
    int32_t result;
    int owns_cur = 0;

    /* R7 = 1 or 2 (VDU output, subpath-by-subpath or not) are explicitly
     * unsupported by Draw_ProcessPath itself, per the PRM ("This call is
     * also unable to handle R7 = 1 or 2"). R7 = &80000000+ptr (bounding
     * box output) is a separate gap - not implemented here. */
    if (r7 == 1 || r7 == 2 || (r7 & (int32_t)0x80000000) != 0)
        return err_DrawUnimplementedDraw;

    /* Step 1 (bit 27, "close open subpaths") is not implemented as a
     * distinct pass - fill() already closes every subpath implicitly for
     * winding purposes, which covers the common case of processing towards
     * a fill, but a dedicated close-subpaths step for other R7 output
     * modes is a known gap (see AGENTS.md). */

    if (fill_style & Draw_FillFlatten)
    {
        if (flatness == 0)
            flatness = DRAW_DEFAULT_FLATNESS;
        scratch = scratch_alloc(path_byte_size(cur));
        if (scratch == NULL)
            return err_DrawPathFull;
        result = flatten(cur, scratch, flatness);
        if (owns_cur)
            free(cur);
        if (result < 0)
        {
            free(scratch);
            return err_DrawPathFull;
        }
        cur = scratch;
        owns_cur = 1;
    }

    if (dash_pattern != NULL)
    {
        scratch = scratch_alloc(path_byte_size(cur));
        if (scratch == NULL)
        {
            if (owns_cur)
                free(cur);
            return err_DrawPathFull;
        }
        result = dash(cur, scratch, dash_pattern);
        if (owns_cur)
            free(cur);
        if (result < 0)
        {
            free(scratch);
            return err_DrawPathFull;
        }
        cur = scratch;
        owns_cur = 1;
    }

    if (fill_style & Draw_FillThicken)
    {
        int32_t use_thickness = (thickness == 0) ? DRAW_HAIRLINE_THICKNESS : thickness;

        scratch = scratch_alloc(path_byte_size(cur));
        if (scratch == NULL)
        {
            if (owns_cur)
                free(cur);
            return err_DrawPathFull;
        }
        result = (line_style != NULL) ? cap(cur, scratch, use_thickness, line_style)
                                       : thicken(cur, scratch, use_thickness);
        if (owns_cur)
            free(cur);
        if (result < 0)
        {
            free(scratch);
            return err_DrawPathFull;
        }
        cur = scratch;
        owns_cur = 1;
    }

    /* Re-flatten after thickening (bit 30) is a no-op here: round caps and
     * joins are already emitted as straight segments rather than curves
     * (see AGENTS.md's "round caps are polygon approximations" caveat),
     * so there is nothing left needing a second flatten pass. */

    if (trfm != NULL)
    {
        scratch = scratch_alloc(path_byte_size(cur));
        if (scratch == NULL)
        {
            if (owns_cur)
                free(cur);
            return err_DrawPathFull;
        }
        result = transform(cur, scratch, trfm);
        if (owns_cur)
            free(cur);
        if (result < 0)
        {
            free(scratch);
            return err_DrawPathFull;
        }
        cur = scratch;
        owns_cur = 1;
    }

    if (r7 == 3)
    {
        regs->r[0] = (int)path_byte_size(cur);
        if (owns_cur)
            free(cur);
        return NULL;
    }

    if (r7 == 0)
    {
        /* Output to the input path buffer, in place - only valid when the
         * path's storage requirement doesn't change (eg transform-only).
         * Not implemented: our stages always assume separate input/output
         * buffers. */
        if (owns_cur)
            free(cur);
        return err_DrawUnimplementedDraw;
    }

    return deliver_path(cur, owns_cur, (Draw_PathElement *)processed_path, regs);
}




/***************************************************************************
 * Description:  SWI handler routine for Draw_Fill
 * Parameters:   number = SWI number within SWI chunk (i.e. 0 to 63)
 *               r      = pointer to register block on entry
 *               pw     = private word for module
 * On exit:      Return NULL if SWI handled sucessfully, setting return
 *               register values (r0-r9) in r.
 *               Return error_BAD_SWI for out of range SWIs.
 *               Return an error block for a custom error.
 **************************************************************************/
_kernel_oserror *SWI_Fill(int number, _kernel_swi_regs *regs, void *pw)
{
    /*
     * Draw_Fill - Processes a path and sends it to the VDU, filling the interior portion
     *
     * =>  R0 -> path
     *     R1 = fill_style
     *     R2 -> trfm
     *     R3 = flatness
     */

    /* Input registers */
    Draw_Path *path = (Draw_Path *)regs->r[0];
    Draw_FillStyle fill_style = (Draw_FillStyle)regs->r[1];
    OS_Trfm *trfm = (OS_Trfm *)regs->r[2];
    int32_t flatness = (int32_t)regs->r[3];

    Draw_PathElement *result;
    Fill_Render render;

    if (fill_style == 0)
        fill_style = DRAW_DEFAULT_FILLSTYLE;

    result = run_pipeline(path, flatness, NULL, 0, 0, NULL, trfm);
    if (result == NULL)
        return err_DrawPathFull;

    render.ctx = NULL;
    render.hline = module_hline;
    render.polyhline = module_polyhline;
    fill(result, fill_style, FILL_SCANLINE_STEP, &render);

    free(result);
    return NULL;
}




/***************************************************************************
 * Description:  SWI handler routine for Draw_Stroke
