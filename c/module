/* Defaults substituted when a SWI parameter is passed as 0 ("use the
 * default"). See AGENTS.md's "Module integration status" for the
 * reasoning behind each of these. */
#define DRAW_DEFAULT_FLATNESS        (Draw_OSUnit)         /* within the PRM's recommended half-to-one-pixel range for a roughly 1:1 transform */
#define DRAW_DEFAULT_FILLSTYLE       ((Draw_FillStyle)0x30) /* Draw_Fill's own documented default: fill to halfway through boundary, non-zero rule */
#define DRAW_DEFAULT_FILLSTYLE_THIN  ((Draw_FillStyle)0x18) /* Draw_Stroke's documented default when R4=0 - same winding rule as above to fill(), which doesn't implement the boundary-pixel-control bits (2-5) either style sets */
#define DRAW_HAIRLINE_THICKNESS      (Draw_OSUnit / 4)      /* R4=0 ("hairline") is approximated as a thin filled stroke rather than true 1-pixel-wide boundary plotting */
#define FILL_SCANLINE_STEP           (Draw_OSUnit)          /* fill()'s scanline granularity - one scanline per OS unit row, matching module_hline()'s own OS_Plot conversion; no direct SWI equivalent */

/* Scratch buffer sizing for intermediate pipeline stages. Dashing and
 * thickening can each expand a path considerably (every line becomes an
 * offset pair plus joins), so a fixed multiplier with a floor comfortably
 * covers realistic paths without needing an exact prediction - see
 * AGENTS.md for why this is a plain malloc()/free() per stage rather than
 * a fixed static workspace or a probe-then-exact-allocate pass. */
#define SCRATCH_MULTIPLIER (8)
#define SCRATCH_MINIMUM    (1024)
#define PLACEHOLDER_SIZE   (8) /* bytes occupied by an EndPath element */


/***************************************************************************
 * Function:     path_byte_size
 * Description:  Walk a path to find its total byte length, including its
 *               terminating EndPath element
 * Parameters:   path-> the path to measure
 * Returns:      total bytes from path's start up to and including its
 *               EndPath element
 **************************************************************************/
static uint32_t path_byte_size(Draw_PathElement *path)
{
    Draw_PathElement *start = path;

    while (path->tag != Draw_EndPath)
        path = advance_element(path);

    return (uint32_t)(((uint8_t *)path) - ((uint8_t *)start)) + PLACEHOLDER_SIZE;
}

/***************************************************************************
 * Function:     scratch_alloc
 * Description:  Allocate a scratch output path buffer, generously sized
 *               relative to hint_bytes (the byte size of whatever feeds
 *               this stage), and initialise its placeholder EndPath
 * Parameters:   hint_bytes = byte size of the input feeding this stage
 * Returns:      a malloc()'d buffer ready for path_writer_init(), or NULL
 *               on allocation failure
 **************************************************************************/
static Draw_PathElement *scratch_alloc(uint32_t hint_bytes)
{
    uint32_t capacity = hint_bytes * SCRATCH_MULTIPLIER;
    Draw_PathElement *buf;

    if (capacity < SCRATCH_MINIMUM)
        capacity = SCRATCH_MINIMUM;

    buf = (Draw_PathElement *)malloc(capacity);
    if (buf == NULL)
        return NULL;

    buf->tag = Draw_EndPath;
    buf->data.end_path = (int32_t)(capacity - PLACEHOLDER_SIZE);
    return buf;
}

/***************************************************************************
 * Function:     find_endpath
 * Description:  Walk a path from its start to find its EndPath terminator -
 *               what most Draw SWIs return in R0 when given a real output
 *               buffer
 * Parameters:   outpath-> the path to search
 * Returns:      pointer to its EndPath element
 **************************************************************************/
static Draw_PathElement *find_endpath(Draw_PathElement *outpath)
{
    while (outpath->tag != Draw_EndPath)
        outpath = advance_element(outpath);
    return outpath;
}

/***************************************************************************
 * Function:     deliver_path
 * Description:  Deliver a finished path to the caller, following the
 *               standard "R1/R7 = 0 means report the size needed, a
 *               pointer means write there" SWI convention
 * Parameters:   result-> the finished path
 *               owns_result = whether result was malloc()'d by us (and so
 *                             must be free()'d here) - false when result is
 *                             still the caller's own input, untouched
 *                             because no stage actually ran
 *               caller_outpath-> the caller's output buffer, or NULL to
 *                                report the required size instead
 *               regs-> the SWI register block, for R0
 * Returns:      NULL on success, or an error if caller_outpath was too
 *               small (result is always freed, on every path)
 **************************************************************************/
static _kernel_oserror *deliver_path(Draw_PathElement *result, int owns_result,
                                      Draw_PathElement *caller_outpath, _kernel_swi_regs *regs)
{
    uint32_t needed;

    if (result == NULL)
        return err_DrawPathFull;

    needed = path_byte_size(result);

    if (caller_outpath == NULL)
    {
        regs->r[0] = (int)needed;
        if (owns_result)
            free(result);
        return NULL;
    }

    {
        uint32_t capacity = (uint32_t)(sizeof(int32_t) * 2) + (uint32_t)caller_outpath->data.end_path;

        if (needed > capacity)
        {
            if (owns_result)
                free(result);
            return err_DrawPathFull;
        }

        memcpy(caller_outpath, result, needed);
        if (owns_result)
            free(result);
        regs->r[0] = (int)find_endpath(caller_outpath);
        return NULL;
    }
}

/***************************************************************************
 * Function:     run_pipeline
 * Description:  Run flatten -> dash (if a pattern is given) -> thicken/cap
 *               (if do_thicken) -> transform (if a matrix is given) on
 *               path, each stage's output malloc()'d fresh and the
 *               previous stage's buffer freed as soon as it's consumed.
 *               This is the shared engine behind Draw_Fill, Draw_Stroke
 *               and Draw_StrokePath - which differ only in what they do
 *               with the result (render it, or hand it back as a path)
 * Parameters:   path-> the input path
 *               flatness = flattening tolerance, or 0 for the default
 *               dash_pattern-> a dash pattern to apply, or NULL
 *               do_thicken = whether to thicken/cap the path at all
 *               thickness = line thickness, or 0 for the hairline default
 *                           (only meaningful if do_thicken)
 *               style-> cap/join style, or NULL for plain butt caps
 *               trfm-> a transformation matrix to apply, or NULL
 * Returns:      a newly malloc()'d final path (caller must free it), or
 *               NULL if any stage failed (its own scratch buffers are
 *               already freed in that case)
 **************************************************************************/
static Draw_PathElement *run_pipeline(Draw_Path *path, int32_t flatness,
                                       Draw_DashPattern *dash_pattern,
                                       int do_thicken, int32_t thickness, Draw_LineStyle *style,
                                       OS_Trfm *trfm)
{
    Draw_PathElement *cur;
    Draw_PathElement *scratch;
    int32_t result;

    if (flatness == 0)
        flatness = DRAW_DEFAULT_FLATNESS;

    scratch = scratch_alloc(path_byte_size((Draw_PathElement *)path));
    if (scratch == NULL)
        return NULL;
    result = flatten((Draw_PathElement *)path, scratch, flatness);
    if (result < 0)
    {
        free(scratch);
        return NULL;
    }
    cur = scratch;

    if (dash_pattern != NULL)
    {
        scratch = scratch_alloc(path_byte_size(cur));
        if (scratch == NULL)
        {
            free(cur);
            return NULL;
        }
        result = dash(cur, scratch, dash_pattern);
        free(cur);
        if (result < 0)
        {
            free(scratch);
            return NULL;
        }
        cur = scratch;
    }

    if (do_thicken)
    {
        int32_t use_thickness = (thickness == 0) ? DRAW_HAIRLINE_THICKNESS : thickness;

        scratch = scratch_alloc(path_byte_size(cur));
        if (scratch == NULL)
        {
            free(cur);
            return NULL;
        }
        result = (style != NULL) ? cap(cur, scratch, use_thickness, style)
                                  : thicken(cur, scratch, use_thickness);
        free(cur);
        if (result < 0)
        {
            free(scratch);
            return NULL;
        }
        cur = scratch;
    }

    if (trfm != NULL)
    {
        scratch = scratch_alloc(path_byte_size(cur));
        if (scratch == NULL)
        {
            free(cur);
            return NULL;
        }
        result = transform(cur, scratch, trfm);
        free(cur);
        if (result < 0)
        {
            free(scratch);
            return NULL;
        }
        cur = scratch;
    }

    return cur;
}

/***************************************************************************
 * Function:     module_hline
 * Description:  Fill_Render hline callback: plot one horizontal run with
 *               OS_Plot. The path coordinates by this point are still in
 *               Draw's internal units (Draw_OSUnit = 256 per OS unit,
 *               regardless of any transform() applied - the transform
 *               matrix only ever maps between internal-unit spaces, per
 *               its own documented translation convention of "multiply OS
 *               unit offset by 256"), so this is the one place that
 *               converts down to the OS units OS_Plot itself expects
 * Parameters:   ctx = unused
 *               x0, y, x1 = the run to plot, in Draw internal units
 * Returns:      none
 **************************************************************************/
static void module_hline(void *ctx, int32_t x0, int32_t y, int32_t x1)
{
    _swix(OS_Plot, _INR(0,2), 4, x0 / Draw_OSUnit, y / Draw_OSUnit);
    _swix(OS_Plot, _INR(0,2), 5, x1 / Draw_OSUnit, y / Draw_OSUnit);
}

/***************************************************************************
 * Function:     module_polyhline
 * Description:  Fill_Render polyhline callback: plot every run on a
 *               scanline via module_hline() in turn
 * Parameters:   ctx-> unused
 *               lines-> the runs to plot
 *               count = number of runs
 * Returns:      none
 **************************************************************************/
static void module_polyhline(void *ctx, const Fill_HLine *lines, int32_t count)
{
    int32_t i;
    for (i = 0; i < count; i++)
        module_hline(ctx, lines[i].x0, lines[i].y, lines[i].x1);
}


