    if (fill_style == 0)
        fill_style = (thickness != 0) ? DRAW_DEFAULT_FILLSTYLE : DRAW_DEFAULT_FILLSTYLE_THIN;

    result = run_pipeline(path, flatness, dash_pattern, 1, thickness, line_style, trfm);
