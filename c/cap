/*******************************************************************
 * File:        cap
 * Purpose:     Finishing a thickened line's open ends with a Draw line-cap
 *              style (butt, round, projecting square or triangular)
 * Author:      Gerph
 ******************************************************************/

#include <stddef.h>

#include "cap.h"
#include "cap_internal.h"
#include "thicken.h"
#include "thicken_internal.h"
#include "geometry.h"
#include "pathio.h"
#include "Asm/muldiv.h"

/* cos/sin of i*PI/8 for i=1..7, as 16.16 fixed-point (65536 = 1.0) -
 * precomputed since the round cap fan only ever sweeps this one fixed set
 * of angles (a semicircle in 8 equal steps), so there is no need for a
 * general run-time trig function (which modules shouldn't use anyway - see
 * AGENTS.md's "modules can't casually use floating point" caveat). */
static const int32_t CAP_ROUND_COS[7] = { 60547, 46341, 25080, 0, -25080, -46341, -60547 };
static const int32_t CAP_ROUND_SIN[7] = { 25080, 46341, 60547, 65536, 60547, 46341, 25080 };

void cap_emit(bufferdata_t *buf,
              Vec2 from, Vec2 to, Vec2 P, Dir2 perp, Dir2 dir,
              int32_t half_thick, Draw_CapStyle style,
              int32_t width_256, int32_t length_256)
{
    switch (style)
    {
        case Draw_CapRound:
        {
            /* Semicircle from 'from', through the outward bulge, to 'to' -
             * approximated with a handful of flat segments, matching the
             * rest of this project's flatten-early approach. Each point is
             * half_thick*(perp*cos + dir*sin); px/py and qx/qy are
             * half_thick*perp/F and half_thick*dir/F (computed once, since
             * they don't depend on the angle), leaving one more muldiv per
             * coordinate per step to bring in cos/sin - this way no
             * individual product ever needs more than 32-bit-safe
             * muldiv() handling (see the file comment in c.geometry). */
            int32_t px = muldiv(half_thick, perp.x, GEOMETRY_FIXED_ONE);
            int32_t py = muldiv(half_thick, perp.y, GEOMETRY_FIXED_ONE);
            int32_t qx = muldiv(half_thick, dir.x, GEOMETRY_FIXED_ONE);
            int32_t qy = muldiv(half_thick, dir.y, GEOMETRY_FIXED_ONE);
            int32_t i;
            for (i = 0; i < 7; i++)
            {
                Vec2 p;
                p.x = P.x + muldiv(px, CAP_ROUND_COS[i], GEOMETRY_FIXED_ONE)
                          + muldiv(qx, CAP_ROUND_SIN[i], GEOMETRY_FIXED_ONE);
                p.y = P.y + muldiv(py, CAP_ROUND_COS[i], GEOMETRY_FIXED_ONE)
                          + muldiv(qy, CAP_ROUND_SIN[i], GEOMETRY_FIXED_ONE);
                path_write_lineto(buf, vec_to_coord(p));
            }
            break;
        }

        case Draw_CapSquare:
        {
            /* Projects both shoulders out by half the line width, giving a
             * flat cap that stands proud of the endpoint rather than
             * sitting flush with it. */
            Vec2 p1, p2;
            int32_t dx = muldiv(half_thick, dir.x, GEOMETRY_FIXED_ONE);
            int32_t dy = muldiv(half_thick, dir.y, GEOMETRY_FIXED_ONE);
            p1.x = from.x + dx;
            p1.y = from.y + dy;
            p2.x = to.x   + dx;
            p2.y = to.y   + dy;
            path_write_lineto(buf, vec_to_coord(p1));
            path_write_lineto(buf, vec_to_coord(p2));
            break;
        }

        case Draw_CapTriangular:
        {
            /* An arrowhead-style point, with the base width and how far the
             * apex stands away from the line both independently settable,
             * as fractions of the line width. */
            Vec2 base1, apex, base2;
            int32_t line_width = half_thick * 2;
            int32_t w = muldiv(line_width, width_256, 256);
            int32_t l = muldiv(line_width, length_256, 256);
            int32_t perp_w_x = muldiv(perp.x, w, GEOMETRY_FIXED_ONE);
            int32_t perp_w_y = muldiv(perp.y, w, GEOMETRY_FIXED_ONE);
            base1.x = P.x + perp_w_x;
            base1.y = P.y + perp_w_y;
            apex.x  = P.x + muldiv(dir.x, l, GEOMETRY_FIXED_ONE);
            apex.y  = P.y + muldiv(dir.y, l, GEOMETRY_FIXED_ONE);
            base2.x = P.x - perp_w_x;
            base2.y = P.y - perp_w_y;
            path_write_lineto(buf, vec_to_coord(base1));
            path_write_lineto(buf, vec_to_coord(apex));
            path_write_lineto(buf, vec_to_coord(base2));
            break;
        }

        case Draw_CapButt:
        default:
            break;
    }

    path_write_lineto(buf, vec_to_coord(to));
}

int32_t cap(Draw_PathElement *inpath, Draw_PathElement *outpath, int32_t thickness,
            Draw_LineStyle *style)
{
    bufferdata_t buf;
    int32_t half_thick = thickness / 2;

    if (style == NULL)
        return thicken(inpath, outpath, thickness);

    path_writer_init(&buf, outpath);

    while (inpath->tag != Draw_EndPath)
    {
        GappedPath gp;

        if (inpath->tag != Draw_MoveTo && inpath->tag != Draw_SpecialMoveTo)
        {
            inpath = advance_element(inpath);
            continue;
        }

        inpath = thicken_read_gapped_subpath(inpath, &gp);

        if (half_thick > 0)
            thicken_process_gapped(&gp, half_thick, style, &buf);
    }

    path_write_endpath(&buf);
    return path_write_result(&buf);
}
